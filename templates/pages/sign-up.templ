package pages

import (
    "etop/templates/components"
    "etop/templates/components/ui"
)

templ SignUp() {
    <div data-title="Sign Up" x-data="{showForm:true,showStatus:false}" class="flex flex-col items-center justify-start bg-muted/40" style="min-height: 80vh;">
        @ui.Card("max-w-md w-full shadow-xl", templ.Attributes{"x-show":"showStatus"}) {
            @components.CardStatus(200, "Account Created", "Register success! Please check your email for verification.", "circle-check-big",
				ui.Button("success", "outline", "", "", "Back to Sign In", "", templ.Attributes{"onclick": "window.location.href='/sign-in'"}))
        }
        @ui.Card("max-w-md w-full shadow-xl", templ.Attributes{"x-show":"showForm"}) {
            @ui.CardHeader("items-center justify-center", nil) {
                @ui.CardTitle("text-center", nil) {
                    <h4>Create an account</h4>
                }
                @ui.CardDescription("flex flex-row flex-wrap items-center justify-center gap-1 text-center", nil) {
                    By signing up, you agree to our 
                    <!-- Privacy -->
                    @ui.DialogRoot("privacy-dialog", "items-center justify-center", nil) {
                        @ui.DialogTrigger("text-primary underline", nil) {
                            <span>Privacy Policy</span>
                        }
                        @ui.DialogOverlay("", nil)
                        @ui.DialogContent("", nil) {
                            @ui.DialogHeader("", nil) {
                                @ui.DialogTitle("", nil) { <span>Privacy Policy</span> }
                                @ui.DialogDescription("", nil) {
                                    <span>How we collect, use, and protect your data.</span>
                                }
                            }
                            <div class="prose prose-sm dark:prose-invert max-h-[60vh] overflow-y-auto text-left">
                                <h3>Information We Collect</h3>
                                <ul class="list-disc pl-5">
                                    <li>Account info (name, email)</li>
                                    <li>Usage data, cookies, device info</li>
                                </ul>
                                <h3 class="pt-2">How We Use Information</h3>
                                <p>Service delivery, security, analytics, and communication.</p>
                                <h3 class="pt-2">Data Protection</h3>
                                <p>We apply reasonable safeguards, but no method is 100% secure.</p>
                            </div>
                            @ui.DialogFooter("", nil) {
                                @ui.DialogClose("px-4 py-2 rounded-md bg-primary text-primary-foreground hover:opacity-90", nil) { <span>Close</span> }
                            }
                        }
                    }
                    and 
                    <!-- Terms of Service -->
                    @ui.DialogRoot("terms-dialog", "items-center justify-center", nil) {
                        @ui.DialogTrigger("text-primary underline cursor-pointer", nil) {
                            <span>Terms of Service</span>
                        }
                        @ui.DialogOverlay("", nil)
                        @ui.DialogContent("", nil) {
                            @ui.DialogHeader("", nil) {
                                @ui.DialogTitle("", nil) { <span>Terms of Service</span> }
                                @ui.DialogDescription("", nil) {
                                    <span>Our rules and conditions for using this service.</span>
                                }
                            }
                            <div class="prose prose-sm dark:prose-invert max-h-[60vh] overflow-y-auto text-left">
                                <h3>Acceptance of Terms</h3>
                                <p>By using our services, you agree to be bound by these terms.</p>

                                <h3 class="pt-2">User Responsibilities</h3>
                                <ul class="list-disc pl-5">
                                    <li>You must provide accurate information.</li>
                                    <li>You are responsible for your account security.</li>
                                    <li>You must comply with applicable laws.</li>
                                </ul>

                                <h3 class="pt-2">Limitations of Liability</h3>
                                <p>We are not liable for damages arising from misuse of our services.</p>
                            </div>
                            @ui.DialogFooter("", nil) {
                                @ui.DialogClose("px-4 py-2 rounded-md bg-primary text-primary-foreground hover:opacity-90", nil) { <span>Close</span> }
                            }
                        }
                    }
                }
            }
            <div class="mx-2">
                @components.DottedSeparator("", "#d4d4d8", "2px", "", "", "horizontal")
            </div>
            @ui.CardContent("", nil) {
                <div 
                    x-data="{
                                full_name: '',
                                email: '',
                                password: '',
                                password2: '',
                                nameError: '',
                                emailError: '',
                                passwordError: '',
                                passwordError2: '',
                                validateName() {
                                    this.nameError = (this.full_name.trim() === '')
                                        ? `Name can't be empty`
                                        : '';
                                },
                                validateEmail() {
                                    this.emailError = (!this.email || this.email === '') 
                                        ? 'Email is required'
                                        : ((!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(this.email)) 
                                            ? 'Email not valid'
                                            : '');
                                },
                                validatePassword() {
                                    this.passwordError = (this.password.length < 6)
                                        ? 'Password must be at least 6 characters'
                                        : '';
                                },
                                validatePassword2() {
                                    this.passwordError2 = (this.password !== this.password2)
                                            ? 'Password not match'
                                            : '';
                                },
                                validateForm(e) {
                                    e.preventDefault();
                                    this.validateName();
                                    this.validateEmail();
                                    this.validatePassword();
                                    this.validatePassword2();
                                    
                                    if (this.nameError || this.emailError || this.passwordError || this.passwordError2) {
                                        return; 
                                    }
                                },
                                init() {
                                    document.body.addEventListener('htmx:afterRequest', (evt) => {
                                        if (evt.detail.successful && evt.detail.elt.id === 'signup-form') {
                                            this.full_name = '';
                                            this.email = '';
                                            this.password = '';
                                            this.password2 = '';
                                            this.showForm = false;
                                            this.showStatus = true;
                                        }
                                    })
                                }
                            }"
                    
                >
                    @ui.Form("/sign-up", "post", "", templ.Attributes{
                        "id":"signup-form",
                        "hx-target": "#toaster",
                        "hx-swap": "beforeend",
                        "hx-disabled-elt":"#signup-button,#google-button,#fullname,#email,#password,#password2",
                        "x-ref": "form",
                        "@submit.prevent":"validateForm($event)",
                    }) {
                        @ui.FormItem("", nil) {
                            @ui.FormLabel("full_name", "Full Name", "", nil)
                            @ui.FormControl("fullname", "full_name", "text", "John Doe", "", "", templ.Attributes{
                                "id": "fullname",
                                "name": "full_name",
                                "autocomplete":"name",
                                "x-model": "full_name",
                                "@blur": "validateName",
                            })
                            @ui.FormMessage("", "", templ.Attributes{
                                    "x-show": "nameError != ''",
                                    "x-text": "nameError",
                                },
                            )
                        }
                        @ui.FormItem("", nil) {
                            @ui.FormLabel("email", "Email Address", "", nil)
                            @ui.FormControl("email", "email", "email", "you@example.com", "", "", templ.Attributes{
                                "id": "email",
                                "name": "email",
                                "autocomplete":"email",
                                "x-model": "email",
                                "@blur": "validateEmail",
                            })
                            @ui.FormMessage("", "", templ.Attributes{
                                    "x-show": "emailError != ''",
                                    "x-text": "emailError",
                                },
                            )
                        }
                        @ui.FormItem("", nil) {
                            @ui.FormLabel("password", "Password", "", nil)
                            @ui.FormControl("password", "password", "password", "********", "", "", templ.Attributes{
                                "id": "password",
                                "x-model": "password",
                                "@blur": "validatePassword",
                            })
                            @ui.FormMessage("", "", templ.Attributes{
                                    "x-show": "passwordError != ''",
                                    "x-text": "passwordError",
                                },
                            )
                        }
                        @ui.FormItem("", nil) {
                            @ui.FormLabel("password2", "Confirm Password", "", nil)
                            @ui.FormControl("password", "password2", "password", "********", "", "", templ.Attributes{
                                "id": "password2",
                                "x-model": "password2",
                                "@blur": "validatePassword2",
                            })
                            @ui.FormMessage("", "", templ.Attributes{
                                    "x-show": "passwordError2 != ''",
                                    "x-text": "passwordError2",
                                },
                            )
                        }
                        
                        @ui.Button("signup-button", "", "lg", "", "Sign In", "w-full", templ.Attributes{"type": "submit"}) 
                        
                        @ui.Button("google-button", "secondary", "lg", "", "", "w-full", templ.Attributes{"type": "button"}) {
                            <svg xmlns="http://www.w3.org/2000/svg" width="16px" height="16px" viewBox="-3 0 262 262" preserveAspectRatio="xMidYMid">
                                <path d="M255.878 133.451c0-10.734-.871-18.567-2.756-26.69H130.55v48.448h71.947c-1.45 12.04-9.283 30.172-26.69 42.356l-.244 1.622 38.755 30.023 2.685.268c24.659-22.774 38.875-56.282 38.875-96.027" fill="#4285F4"/>
                                <path d="M130.55 261.1c35.248 0 64.839-11.605 86.453-31.622l-41.196-31.913c-11.024 7.688-25.82 13.055-45.257 13.055-34.523 0-63.824-22.773-74.269-54.25l-1.531.13-40.298 31.187-.527 1.465C35.393 231.798 79.49 261.1 130.55 261.1" fill="#34A853"/>
                                <path d="M56.281 156.37c-2.756-8.123-4.351-16.827-4.351-25.82 0-8.994 1.595-17.697 4.206-25.82l-.073-1.73L15.26 71.312l-1.335.635C5.077 89.644 0 109.517 0 130.55s5.077 40.905 13.925 58.602l42.356-32.782" fill="#FBBC05"/>
                                <path d="M130.55 50.479c24.514 0 41.05 10.589 50.479 19.438l36.844-35.974C195.245 12.91 165.798 0 130.55 0 79.49 0 35.393 29.301 13.925 71.947l42.211 32.783c10.59-31.477 39.891-54.251 74.414-54.251" fill="#EB4335"/>
                            </svg>
                            Login with Google
                        }
                    }
                </div>
            }
            <div class="mx-2">
                @components.DottedSeparator("", "#d4d4d8", "2px", "", "", "horizontal")
            </div>
            @ui.CardFooter("items-center justify-center", nil) {
                <div class="flex items-center justify-center">
                    <p class="text-sm text-muted-foreground">
                        Already have an account? 
                        <span class="text-blue-700 cursor-pointer"
                            hx-get="/sign-in"
                            hx-target="#content"
                            hx-swap="true"
                            hx-push-url="true">Sign In</span>
                    </p>
                </div>
            }
        }
    </div>
}