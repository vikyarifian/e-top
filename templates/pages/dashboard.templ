package pages

import "etop/templates/layouts"

// Dashboard Page
templ Dashboard() {
    @layouts.Layout() {
	<div class="space-y-6">
		<div>
			<h2 class="text-3xl font-bold tracking-tight">Dashboard</h2>
			<p class="text-muted-foreground">Welcome to your dashboard</p>
		</div>

		<!-- Stats Cards -->
		<div class="grid gap-4 md:grid-cols-2 lg:grid-cols-4">
			<div class="rounded-lg border border-border bg-card text-card-foreground shadow-sm p-6">
				<div class="flex items-center justify-between space-y-0 pb-2">
					<h3 class="tracking-tight text-sm font-medium">Total Revenue</h3>
					<svg class="h-4 w-4 text-muted-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 2v20M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"></path>
					</svg>
				</div>
				<div>
					<div class="text-2xl font-bold">$45,231.89</div>
					<p class="text-xs text-muted-foreground">+20.1% from last month</p>
				</div>
			</div>
			
			<div class="rounded-lg border border-border bg-card text-card-foreground shadow-sm p-6">
				<div class="flex items-center justify-between space-y-0 pb-2">
					<h3 class="tracking-tight text-sm font-medium">Subscriptions</h3>
					<svg class="h-4 w-4 text-muted-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
					</svg>
				</div>
				<div>
					<div class="text-2xl font-bold">+2350</div>
					<p class="text-xs text-muted-foreground">+180.1% from last month</p>
				</div>
			</div>

			<div class="rounded-lg border border-border bg-card text-card-foreground shadow-sm p-6">
				<div class="flex items-center justify-between space-y-0 pb-2">
					<h3 class="tracking-tight text-sm font-medium">Sales</h3>
					<svg class="h-4 w-4 text-muted-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4m0 0L7 13m0 0l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17M17 13v4a2 2 0 01-2 2H9a2 2 0 01-2-2v-4m8 0V9a2 2 0 00-2-2H9a2 2 0 00-2 2v4.01"></path>
					</svg>
				</div>
				<div>
					<div class="text-2xl font-bold">+12,234</div>
					<p class="text-xs text-muted-foreground">+19% from last month</p>
				</div>
			</div>

			<div class="rounded-lg border border-border bg-card text-card-foreground shadow-sm p-6">
				<div class="flex items-center justify-between space-y-0 pb-2">
					<h3 class="tracking-tight text-sm font-medium">Active Now</h3>
					<svg class="h-4 w-4 text-muted-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
					</svg>
				</div>
				<div>
					<div class="text-2xl font-bold">+573</div>
					<p class="text-xs text-muted-foreground">+201 since last hour</p>
				</div>
			</div>
		</div>

		<!-- Chart Area -->
		<div class="rounded-lg border border-border bg-card text-card-foreground shadow-sm p-6">
			<h3 class="font-semibold leading-none tracking-tight mb-4">Overview</h3>
			<div class="h-64 flex items-center justify-center text-muted-foreground">
				Detailed analytics chart placeholder
			</div>
		</div>
	</div>
    }
}

