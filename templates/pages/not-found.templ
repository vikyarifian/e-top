package pages

import (
    "etop/templates/components/ui"
)

// NotFound Page
templ NotFound() {
	<div class="space-y-6" data-title="404 Page Not Found">
        <div>
			<h2 class="text-3xl font-bold tracking-tight">Oops!</h2>
			<p class="text-muted-foreground">Sorry, the page you are looking for could not be found.</p>
		</div>
		
		<!-- Action -->
        <div class="text-card-foreground p-6">
			<div class="flex flex-col items-center justify-start">  
                <!-- Big Oops -->
                <h1 class="galaxy-text font-extrabold mb-4 text-8xl sm:text-[96px] lg:text-[120px] leading-none tracking-tight dark:opacity-50">404</h1>

                <!-- Subtitle -->
                <p class="text-gray-500 max-w-lg text-center mb-6">
                    The page you are looking for might have been removed,<br>
                    had its name changed, or is temporarily unavailable.
                </p>
				@ui.Button("back-dasboard", "outline", "", "", "Back to Dashboard", "", 
                    templ.Attributes{"type": "button","hx-post":"/","hx-target":"#content","hx-swap":"innerHTML","hx-push-url":"true"})
			</div>
		</div>
	</div>
}
