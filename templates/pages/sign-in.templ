package pages

import (
    "etop/templates/layouts"
    "etop/templates/components"
    "etop/templates/components/ui"
)

templ SignIn() {
    @layouts.AuthLayout() {
        <div class="min-h-screen flex flex-col items-center justify-center bg-muted/40 p-6"
            x-data="{ pageTitle: 'Sign In - etop' }" 
            x-init="document.title = pageTitle; $watch('pageTitle', value => document.title = value);"
        >
            <div class="flex items-center mb-4">
                <div class="w-14 h-14 bg-green-600 rounded-lg flex items-center justify-center px-5">
                    <span class="text-[48px] text-primary-foreground font-semibold" style="margin-top: -10px">e</span>
                </div>
                <span class="font-bold text-[46px] pb-1.8 pl-2.5 pt-0">top</span>
            </div>
            
            @ui.Card("max-w-md w-full shadow-xl") {
                @ui.CardHeader("items-center justify-center") {
                    @ui.CardTitle("") {
                        <h4>Welcome back</h4>
                    }
                    @ui.CardDescription("") {
                        Sign in to your account to continue
                    }
                }
                <div class="mx-2">
                    @components.DottedSeparator("", "#d4d4d8", "2px", "", "", "horizontal")
                </div>
                @ui.CardContent("") {
                    <div 
                        x-data="{
                                    email: '',
                                    password: '',
                                    emailError: '',
                                    passwordError: '',
                                    validateEmail() {
                                        this.emailError = (!this.email.includes('@'))
                                            ? 'Email not valid'
                                            : '';
                                    },
                                    validatePassword() {
                                        this.passwordError = (this.password.length < 8)
                                            ? 'Minimum 8 characters'
                                            : '';
                                    },
                                    validateForm() {
                                        this.validateEmail();
                                        this.validatePassword();
                                        if (this.emailError || this.passwordError) return;
                                        $el.querySelector('form').submit();
                                    }
                                }"
                        
                    >
                        @ui.Form("/submit", "post", templ.Attributes{
                            "hx-swap":"none", 
                            "@submit.prevent":"validateForm",
                        }) {
                            @ui.FormItem() {
                                @ui.FormLabel("email", "Email Address")
                                @ui.FormControl("email", "email", "email", "you@example.com", "", templ.Attributes{
                                    "x-model": "email",
                                    "@blur": "validateEmail",
                                })
                                @ui.FormMessage(templ.Attributes{
                                        "x-show": "emailError != ''",
                                        "x-text": "emailError",
                                    },
                                    "",
                                )
                            }
                            @ui.FormItem() {
                                @ui.FormLabel("password", "Password")
                                @ui.FormControl("password", "password", "password", "********", "", templ.Attributes{
                                    "x-model": "password",
                                    "@blur": "validatePassword",
                                })
                                @ui.FormMessage(templ.Attributes{
                                        "x-show": "passwordError != ''",
                                        "x-text": "passwordError",
                                    },
                                    "",
                                )
                            }
                            
                            @ui.Button("", "lg", "", "Sign In", "w-full", templ.Attributes{"type": "submit"})
                            <div class="mx-2">
                                @components.DottedSeparator("", "#d4d4d8", "2px", "", "", "horizontal")
                            </div>
                            @ui.Button("secondary", "lg", "mail", "", "w-full", templ.Attributes{"type": "button"}) {
                                <svg xmlns="http://www.w3.org/2000/svg" width="16px" height="16px" viewBox="-3 0 262 262" preserveAspectRatio="xMidYMid"><path d="M255.878 133.451c0-10.734-.871-18.567-2.756-26.69H130.55v48.448h71.947c-1.45 12.04-9.283 30.172-26.69 42.356l-.244 1.622 38.755 30.023 2.685.268c24.659-22.774 38.875-56.282 38.875-96.027" fill="#4285F4"/><path d="M130.55 261.1c35.248 0 64.839-11.605 86.453-31.622l-41.196-31.913c-11.024 7.688-25.82 13.055-45.257 13.055-34.523 0-63.824-22.773-74.269-54.25l-1.531.13-40.298 31.187-.527 1.465C35.393 231.798 79.49 261.1 130.55 261.1" fill="#34A853"/><path d="M56.281 156.37c-2.756-8.123-4.351-16.827-4.351-25.82 0-8.994 1.595-17.697 4.206-25.82l-.073-1.73L15.26 71.312l-1.335.635C5.077 89.644 0 109.517 0 130.55s5.077 40.905 13.925 58.602l42.356-32.782" fill="#FBBC05"/><path d="M130.55 50.479c24.514 0 41.05 10.589 50.479 19.438l36.844-35.974C195.245 12.91 165.798 0 130.55 0 79.49 0 35.393 29.301 13.925 71.947l42.211 32.783c10.59-31.477 39.891-54.251 74.414-54.251" fill="#EB4335"/></svg>
                                 Login with Google
                            }
                        }
                    </div>
                }
                <div class="mx-2">
                    @components.DottedSeparator("", "#d4d4d8", "2px", "", "", "horizontal")
                </div>
                @ui.CardFooter("items-center justify-center") {
                    <div class="flex items-center justify-center">
                        <p class="text-sm text-muted-foreground cursor-pointer">
                            Don't have account? <span hx-get="/sign-up" hx-swap="none">Sign Up</span>
                        </p>
                    </div>
                }
            }
        </div>
    }
}