                    if (filtered.length === 0) {
                        filterMembers()
                    } else {
                        moveDown()
                    }
                "
                @keydown.up.prevent="moveUp"
                @keydown.enter.prevent="selectHighlighted"
                placeholder={placeholder}
                class="flex-1 px-2 py-1 text-sm focus:ring-0 focus:outline-none border-none flex h-11 w-full rounded-md bg-transparent px-3 py-1 text-sm file:text-sm file:font-medium file:text-foreground placeholder:text-muted-foreground outline-none disabled:cursor-not-allowed disabled:opacity-50"
            />
        </div>

        <!-- dropdown -->
