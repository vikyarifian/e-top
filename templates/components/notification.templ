package components

import (
    "etop/templates/components/ui"
)

type Notif struct {
    Title string
    Content string
}

templ Notification(notif []Notif) {
    @ui.Dropdown("notifButton", "", nil) {
		@ui.DropdownTrigger("flex items-center p-2 rounded-md hover:bg-accent", templ.Attributes{
		}) {
			<div data-lucide="bell" class="w-6 h-6"  stroke="currentColor" />
		}

		/* Panel dropdown */
		@ui.DropdownContent("w-96", nil) {
			@ui.DropdownLabel(false, "flex items-center justify-center font-sm", nil) {
                Notifications
            }

            @ui.DropdownSeparator("", nil)

            // Item 1 - Pesan Baru
			@NotifContent("wq", "Bdu", "Bdu", "sent you a message yesterday sent you a message yesterday")
            @NotifContent("qw","Andi", "Andi", "sent you a message last year last year")
			@NotifContent("as", "Cahy", "Cahy", "sent you a message please reply")
            
            @ui.DropdownSeparator("", nil)

            // Item 2 - System Update
            @ui.DropdownItem(false, false, "hover:bg-accent", nil) {
                <div class="flex gap-3 items-start">
                    <div class="size-8 rounded-full bg-green-100 text-green-600 flex items-center justify-center">
                        <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M12 8v4l3 3"/>
                        </svg>
                    </div>
                    <div class="flex flex-col text-sm">
                        <span class="font-medium">System Update</span>
                        <span class="text-xs opacity-70">Version 2.1 installed</span>
                        <span class="text-xs opacity-50">10 min ago</span>
                    </div>
                </div>
            }

            // Item 3 - Reminder
            @ui.DropdownItem(false, false, "hover:bg-accent", nil) {
                <div class="flex gap-3 items-start">
                    <div class="size-8 rounded-full bg-yellow-100 text-yellow-600 flex items-center justify-center">
                        <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M12 8v4l3 3"/>
                        </svg>
                    </div>
                    <div class="flex flex-col text-sm">
                        <span class="font-medium">Meeting Reminder</span>
                        <span class="text-xs opacity-70">Project kickoff at 3:00 PM</span>
                        <span class="text-xs opacity-50">30 min ago</span>
                    </div>
                </div>
            }

            @ui.DropdownSeparator("", nil)

            @ui.DropdownItem(false, false, "justify-center text-blue-600 font-sm cursor-pointer", nil) {
                View all notifications
            }
		}
	}
}

templ NotifContent(id string, from string, title string, message string) {
    @ui.DropdownItem(false, false, "hover:bg-accent", nil) {
        <div class="flex gap-2 items-start w-full">
            @ui.Avatar(from, "xs", "mt-0.5", nil) 
            <div class="flex flex-col text-sm">
                <span class="font-medium">{title}</span>
                <span class="text-xs opacity-70">{message}</span>
                <span class="text-xs opacity-50">2 min ago</span>
            </div>
            @ui.DropdownSub("ml-auto flex items-center", nil) {
                @ui.DropdownSubTrigger("sub"+id, false, "p-1", nil) {
                    <div data-lucide="ellipsis-vertical" class="w-4 h-4" />
                }
                @ui.DropdownSubContent("sub"+id, "", nil) {
                    <div>Hide this</div>
                    <div>Nonactive all</div>
                }
            }
        </div>
    }
}