package ui

// Sonner (Toast) component
templ Toast(id, _type, title, description string) {
    <div class={
            "fixed bottom-4 right-4 z-50 w-full max-w-sm rounded-lg border p-4 shadow-lg transition-all",
            templ.KV("bg-background border-border", _type == "default"),
            templ.KV("bg-destructive text-destructive-foreground border-destructive", _type == "error"),
            templ.KV("bg-green-600 text-white border-green-600", _type == "success"),
            templ.KV("bg-yellow-600 text-white border-yellow-600", _type == "warning"),
        }
        id={id} 
    >
        <div class="flex items-start gap-3">
            if _type == "success" {
                <i data-lucide="check-circle" class="w-5 h-5 mt-0.5"></i>
            } else if _type == "error" {
                <i data-lucide="x-circle" class="w-5 h-5 mt-0.5"></i>
            } else if _type == "warning" {
                <i data-lucide="alert-triangle" class="w-5 h-5 mt-0.5"></i>
            } else {
                <i data-lucide="info" class="w-5 h-5 mt-0.5"></i>
            }
            
            <div class="flex-1">
                <h4 class="font-medium">{ title }</h4>
                if description != "" {
                    <p class="text-sm opacity-90">{ description }</p>
                }
            </div>
            
            <button onclick="this.parentElement.parentElement.remove()" class="opacity-70 hover:opacity-100">
                <i data-lucide="x" class="w-4 h-4"></i>
            </button>
        </div>
    </div>
}