package ui

// Checkbox component
templ Checkbox(name, value string, checked bool, attrs templ.Attributes) {
    <div class="flex items-center space-x-2">
        <input 
            type="checkbox"
            name={ name }
            value={ value }
            checked?={ checked }
            class="h-4 w-4 rounded border border-input text-primary focus:ring-2 focus:ring-ring focus:ring-offset-2"
            { attrs... }
        />
    </div>
}