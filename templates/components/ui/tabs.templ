package ui

import "fmt"

// Tabs Component
templ Tabs(defaultValue string, class string, attrs templ.Attributes) {
	<div class={"w-full", class} data-default-value={defaultValue} {attrs...}>
		{children...}
	</div>
}

templ TabsList(class string, attrs templ.Attributes) {
	<div class={"inline-flex h-10 items-center justify-center rounded-md bg-muted p-1 text-muted-foreground ", class} {attrs...}>
		{children...}
	</div>
}

templ TabsTrigger(value string, class string, attrs templ.Attributes) {
	<button
		class={"inline-flex items-center justify-center whitespace-nowrap rounded-sm px-3 py-1.5 text-sm font-medium ring-offset-background transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 data-[state=active]:bg-background data-[state=active]:text-foreground data-[state=active]:shadow-sm", class}
		data-value={value}
		onclick={templ.ComponentScript{Call:fmt.Sprintf("switchTab('%s')", value)}}
		{attrs...}
	>
		{children...}
	</button>
}

templ TabsContent(value string, class string, attrs templ.Attributes) {
	<div
		class={"mt-2 ring-offset-background focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2", class}
		data-value={value}
		id={fmt.Sprintf("tab-content-%s", value)}
		{attrs...}
	>
		{children...}
	</div>
}