package ui

import (
	"fmt"
	"strings"
	
    "etop/utils"
)

// Avatar Component
templ Avatar(text string, size string, class string, attrs templ.Attributes) {
	<div class="flex items-center">
		<div class={"rounded-full flex items-center justify-center",
					class,
					utils.TailwindForUsername(text),
					templ.KV("h-4 w-4", size == "xxs"),
					templ.KV("h-6 w-6", size == "xs"),
					templ.KV("h-8 w-8", size == "sm"),
					templ.KV("h-10 w-10", size == "md"),
					templ.KV("h-12 w-12", size == "lg"),
					templ.KV("h-10 w-10", size == "")
				}
			:class={fmt.Sprintf("darkMode ? 'dark:bg-gray-500 dark:text-white' : '%s'",utils.TailwindForUsername(strings.Trim(text," ")))}
			{attrs...}
		>
			<span class="text-sm font-medium text-primary-foreground">{ strings.Trim(strings.ToUpper(text[0:1])," ") }</span>
		</div>
	</div>
}

templ AvatarImage(src string, alt string, class string, attrs templ.Attributes) {
	<img class={"aspect-square", class} src={src} alt={alt} {attrs...}/>
}

templ AvatarFallback(class string, attrs templ.Attributes) {
	<div class={"flex items-center justify-center rounded-full bg-muted ", class} {attrs...}>
		{ children... }
	</div>
}
