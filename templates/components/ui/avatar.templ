package ui

import "fmt"

// Avatar Component
templ Avatar(size string, class string) {
	<div class={fmt.Sprintf("relative flex shrink-0 overflow-hidden rounded-full %s %s", getAvatarSize(size), class)}>
		{ children... }
	</div>
}

templ AvatarImage(src string, alt string) {
	<img class="aspect-square h-full w-full" src={src} alt={alt}/>
}

templ AvatarFallback(class string) {
	<div class={fmt.Sprintf("flex h-full w-full items-center justify-center rounded-full bg-muted %s", class)}>
		{ children... }
	</div>
}

func getAvatarSize(size string) string {
	switch size {
	case "sm":
		return "h-8 w-8"
	case "md":
		return "h-10 w-10"
	case "lg":
		return "h-12 w-12"
	default:
		return "h-10 w-10"
	}
}