package ui

// Root: bungkus semua primitive di dalam ini
// - open state dikelola Alpine: open: false|true
// - attrs opsional untuk menambah kelas/atribut ekstra di root (mis. class)
// Dialog component
templ DialogRoot(id string, class string, attrs templ.Attributes) {
	<div
		id={id}
		x-data="{ openDialog: false }"
		@openDialog-dialog.window="if ($event.detail.id === '{id}') openDialog = true"
		@close-dialog.window="if ($event.detail.id === '{id}') openDialog = false"
		class={class}
		{attrs...}
	>
		{children...}
	</div>
}

// Trigger: tombol/pemicu untuk buka dialog (harus di dalam Root)
templ DialogTrigger(class string, attrs templ.Attributes) {
	<button
		type="button"
		@click="openDialog = true"
		class={class}
		{attrs...}
	>
		{children...}
	</button>
}

templ ExternalTrigger(targetID string, class string, attrs templ.Attributes) {
	<button
		type="button"
		@click="$dispatch('openDialog-dialog', { id: '{targetID}' })"
		class={class}
		{attrs...}
	>
		{children...}
	</button>
}

// Overlay: backdrop gelap ala shadcn
templ DialogOverlay(class string, attrs templ.Attributes) {
	<div
		x-show="openDialog"
		x-transition.opacity
		:data-state="openDialog ? 'openDialog' : 'closed'"
		class={"fixed inset-0 z-50 bg-black/80 data-[state=openDialog]:animate-in data-[state=closed]:animate-out data-[state=closed]:fade-out-0 data-[state=openDialog]:fade-in-0 ", class}
		{attrs...}
	></div>
}

// Content: kotak dialog di tengah layar
templ DialogContent(class string, attrs templ.Attributes) {
	<div
		x-show="openDialog"
		x-transition
		:data-state="openDialog ? 'openDialog' : 'closed'"
		class={"fixed left-[50%] top-[50%] z-50 grid w-full max-w-lg translate-x-[-50%] translate-y-[-50%] gap-4 border bg-background p-6 shadow-lg duration-200 data-[state=openDialog]:animate-in data-[state=closed]:animate-out data-[state=closed]:fade-out-0 data-[state=openDialog]:fade-in-0 data-[state=closed]:zoom-out-95 data-[state=openDialog]:zoom-in-95 data-[state=closed]:slide-out-to-left-1/2 data-[state=closed]:slide-out-to-top-[48%] data-[state=openDialog]:slide-in-from-left-1/2 data-[state=openDialog]:slide-in-from-top-[48%] sm:rounded-lg ", class}
		role="dialog"
		aria-modal="true"
		@click.outside="openDialog = false"
		{attrs...}
	>
		{children...}

		<!-- Close (pojok kanan atas) -->
		<button
			type="button"
			@click="openDialog = false"
			class="absolute right-4 top-4 rounded-sm opacity-70 ring-offset-background transition-opacity hover:opacity-100
                   focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2 disabled:pointer-events-none
                   data-[state=openDialog]:bg-accent data-[state=openDialog]:text-muted-foreground"
			aria-label="Close"
		>
			<i data-lucide="x" class="h-4 w-4"></i>
			<span class="sr-only">Close</span>
		</button>
	</div>
}

// Header/Footer/Title/Description: util layout seperti shadcn
templ DialogHeader(class string, attrs templ.Attributes) {
	<div class={"flex flex-col space-y-1.5 text-center sm:text-left ", class} {attrs...}>{children...}</div>
}

templ DialogFooter(class string, attrs templ.Attributes) {
	<div class={"flex flex-col-reverse sm:flex-row sm:justify-end sm:space-x-2 ", class} {attrs...}>{children...}</div>
}

templ DialogTitle(class string, attrs templ.Attributes) {
	<h2 class={"text-lg font-semibold leading-none tracking-tight ", class} {attrs...}>{children...}</h2>
}

templ DialogDescription(class string, attrs templ.Attributes) {
	<p class={"text-sm text-muted-foreground ", class} {attrs...}>{children...}</p>
}

// DialogClose: tombol tutup (biasanya di footer)
templ DialogClose(class string, attrs templ.Attributes) {
	<button type="button" @click="openDialog = false" class={class} {attrs...}>{children...}</button>
}
