package ui

import (
    "fmt"
)

templ Select(name string, value string, options []SelectOption, class string, attrs templ.Attributes) {
    <div class={fmt.Sprintf("w-64 %s", class)} {attrs...}>
        <!-- Dropdown Wrapper -->
        <div x-data="{ openSelect: false, selected: { value: '', label: '', color: '' } }" class="relative">
            
            <!-- Trigger -->
            <button 
                @click="openSelect = !openSelect" 
                class="w-full flex justify-between items-center px-3 py-2 
                        border rounded-md 
                        bg-background text-foreground border-border 
                        hover:bg-accent hover:text-accent-foreground
                        focus:outline-none transition-colors"
            >
                <div class="flex items-center space-x-2">
                    <!-- Avatar warna kecil -->
                    <div x-show="selected.value !== ''" 
                         class="w-6 h-6 rounded-md text-white flex items-center justify-center text-xs font-semibold" 
                         :class="selected.color">
                        <span x-text="selected.label.slice(0,1)"></span>
                    </div>
                    <!-- Icon default -->
                    <div x-show="selected.value === ''" class="w-4 h-4 ml-0" data-lucide="list-checks" />
                    <!-- Label -->
                    <span x-text={fmt.Sprintf("selected.label || 'Select %s'",name)}></span>
                </div>
                <svg class="w-4 h-4 text-muted-foreground" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
            </button>

            <!-- Dropdown -->
            <div 
                x-show="openSelect" 
                @click.away="openSelect = false" 
                class="absolute z-10 mt-1 w-full rounded-md border shadow-lg bg-popover border-border text-popover-foreground"
            >
                <div class="px-3 pt-2 pb-1 text-sm text-muted-foreground">{name}</div>
                <ul class="max-h-60 overflow-auto">
                    for _, item := range options {
                        <li 
                            class="flex items-center space-x-2 px-3 py-2 
                                    cursor-pointer 
                                    hover:bg-accent hover:text-accent-foreground" 
                            @click={fmt.Sprintf("selected = { label: '%s', value: '%s', color: '%s' }; openSelect = false",item.Label,item.Value,item.Color)}
                        >
                            <div class={"w-6 h-6 rounded-md text-white flex items-center justify-center text-xs font-semibold " , item.Color}
                                 >{item.Label[0:1]}</div>
                            <span>{item.Label}</span>
                        </li>
                    }
                    @Separator("horizontal", "", nil)
                    { children... }
                </ul>
            </div>
        </div>
    </div>
    <script>
        lucide.createIcons();
    </script>
}


