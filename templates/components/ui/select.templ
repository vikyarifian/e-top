package ui

// Select component
templ Select(name, value string, options []SelectOption, attrs templ.Attributes) {
    <select 
        name={ name }
        class="flex h-8 w-full items-center justify-between rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50"
        { attrs... }
    >
        for _, option := range options {
            <option value={ option.Value } selected?={ option.Value == value }>
                { option.Label }
            </option>
        }
    </select>
}

type SelectOption struct {
    Value string
    Label string
}