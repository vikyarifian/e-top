package ui

import (
	"fmt"
)

//
// Usage examples
// @ui.Progress("p1", 45, 100, "md", "mb-4", templ.Attributes{})                      // determinate 45%
// @ui.Progress("p2", -1, 100, "md", "mb-4", templ.Attributes{})                     // indeterminate (loading)
// @ui.Progress("p3", 73, 200, "lg", "mb-4", templ.Attributes{"data-note":"x"})     // supports attrs
//

// Progress renders a progress bar.
// - id: element id
// - value: current value (if negative -> indeterminate mode)
// - max: maximum value used for percent calculation (ignored in indeterminate)
// - size: "sm","md","lg" -> height of track
// - class: extra classes to apply to wrapper
// - attrs: extra attributes to spread on outer wrapper
templ Progress(id string, value int, max int, size string, class string, attrs templ.Attributes) {
	<div
		id={id}
		x-data={`
			{
				value: ` + fmt.Sprintf("%d", value) + `,
				max: ` + fmt.Sprintf("%d", max) + `,
				size: '` + size + `',
				get percent() {
					if (this.max <= 0) return 0
					if (this.value < 0) return 0
					if (this.value <= 0) return 0
					if (this.value >= this.max) return 100
					return Math.round((this.value / this.max) * 100)
				},
				get indeterminate() {
					return this.value < 0
				},
				get heightClass() {
					switch (this.size) {
						case 'sm': return 'h-1.5'
						case 'lg': return 'h-3'
						default: return 'h-2'
					}
				},
				get labelTextClass() {
					switch (this.size) {
						case 'lg': return 'text-sm'
						default: return 'text-xs'
					}
				},
				update(v, m) {
					this.value = v
					this.max = m
				}
			}
		`}
		class={"w-full", class}
		{attrs...}
	>
		// <div class="flex items-center justify-between mb-2">
		// 	<div class="text-sm font-medium text-foreground">Progress</div>
		// 	<div :class="labelTextClass" class="text-muted-foreground">
		// 		<span x-text="indeterminate ? 'Loading…' : (percent + '%')"></span>
		// 	</div>
		// </div>

		<!-- track -->
		<div :class="heightClass" class="relative overflow-hidden rounded-md bg-muted" aria-hidden="true">
			<!-- determinate -->
			<div
				x-show="!indeterminate"
				:style="`width: ${percent}%`"
				class="absolute left-0 top-0 h-full transition-all duration-300 ease-out bg-blue-500"
			></div>
			<!-- indeterminate -->
			<div
				x-show="indeterminate"
				class="absolute inset-0 bg-gradient-to-r from-blue-400 to-blue-600 animate-pulse"
			></div>
		</div>
	</div>
}