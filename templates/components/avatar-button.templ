package components

import (
    "etop/utils"
    "etop/templates/components/ui"

    "fmt"
)

// UserButton — dropdown user menu with avatar + logout
templ AvatarButton(name, email string) {
	@ui.Dropdown("avatarButton", "", nil) {
		@ui.DropdownTrigger("avatarButton", "", templ.Attributes{
		}) {
            <div class="flex items-center gap-2">
                <div class="w-8 h-8 rounded-full flex items-center justify-center" style={fmt.Sprintf("background-color: %s;", utils.LetterToColor(name[0:1]))}>
                    <span class="text-sm font-medium text-primary-foreground">{ string([]rune(name)[0]) }</span>
                </div>
            </div>
		}

		/* Panel dropdown */
		@ui.DropdownContent("avatarButton", "w-60", nil) {
			<!-- header user info -->
			<div class="flex flex-col items-center justify-center gap-2 p-4">
				<div class="flex flex-col items-center justify-center">
					<p class="text-md font-semibold">
						{ name } 
					</p>
					<p class="text-sm text-neutral-500">
						{ email } 
					</p>
				</div>
			</div>

			<!-- dotted separator -->
			<div class="-mx-1 my-1 h-px border-t border-dotted border-neutral-300"></div>

			<!-- Logout -->
			@ui.DropdownItem("avatarButton", false, false, "h-10 flex items-center justify-center text-amber-700 text-sm cursor-pointer dark:hover:bg-gray-400 hover:bg-red-100", templ.Attributes{
				"hx-post": "/logout",
				"hx-target": "body",
				"hx-swap": "none",
			}) {
				<i data-lucide="log-out" class="w-4 h-4"></i>
				Log out
			}
		}
	}
}
