package components

import (
    "etop/utils"
    "etop/templates/components/ui"

    "fmt"
)
// UserButton — dropdown user menu dengan avatar inisial + logout
templ UserButton(name, email string) {


	@ui.Dropdown("user-menu", "", nil) {
		/* Trigger: avatar kecil bulat */
		@ui.DropdownTrigger("", templ.Attributes{
			// NB: komponen Trigger sudah punya kelas default sendiri.
			// Jangan kirim "class" lagi agar tidak duplikat attribute.
			// Biar tombol terlihat bulat, kita bungkus avatar di dalamnya.
		}) {
            <div class="flex items-center gap-2">
                <div class="w-8 h-8 rounded-full flex items-center justify-center" style={fmt.Sprintf("background-color: %s;", utils.LetterToColor(name[0:1]))}>
                    <span class="text-sm font-medium text-primary-foreground">{ string([]rune(name)[0]) }</span>
                </div>
            </div>
			// <div class="size-10 rounded-full bg-neutral-200 border border-neutral-300 flex items-center justify-center">
			// 	<span class="text-neutral-600 font-medium">{ string([]rune(name)[0]) }</span>
			// </div>
		}

		/* Panel dropdown */
		@ui.DropdownContent("w-60", nil) {
			<!-- header user info -->
			<div class="flex flex-col items-center justify-center gap-2 p-4">
				// <div class="size-14 rounded-full bg-neutral-200 border border-neutral-300 flex items-center justify-center">
				// 	<span class="text-neutral-600 text-xl font-medium">{ string([]rune(name)[0]) }</span>
				// </div>
				<div class="flex flex-col items-center justify-center">
					<p class="text-md font-semibold">
						{ name } 
					</p>
					<p class="text-sm text-neutral-500">
						{ email } 
					</p>
				</div>
			</div>

			<!-- dotted separator -->
			<div class="-mx-1 my-1 h-px border-t border-dotted border-neutral-300"></div>

			<!-- Logout -->
			@ui.DropdownItem(false, false, "h-10 flex items-center justify-center text-amber-700 text-sm cursor-pointer ", templ.Attributes{
				"hx-post": "/logout",
				"hx-target": "body",
				"hx-swap": "none",
			}) {
				<i data-lucide="log-out" class="w-4 h-4"></i>
				Log out
			}
		}
	}
}
