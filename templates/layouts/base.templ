package layouts

import (
	"os"
	"fmt"
	"strings"

	"etop/dto"
	"etop/utils"
	"etop/services"
	"etop/templates/features"
	"etop/templates/components"
)

// Base Layout
templ Layout(title string, user dto.UserAuth, content ...templ.Component) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{title} - {os.Getenv("APP_NAME")}</title>
			// <link rel="icon" href="/favicon.ico" type="image/x-icon">
			<link rel="icon" href="data:,">
			<link rel="stylesheet" href="/public/css/styles.css"/>
			<script src="/public/js/htmx.min.js"></script>
			<script src="/public/js/cdn.min.js" defer></script>
            <script src="/public/js/lucide.js"></script>
			<style>
				
			</style>
		</head>
		<body 
			class="min-h-screen bg-background text-foreground"
			:class="darkMode ? 'dark' : ''"
			x-data={fmt.Sprintf("{ auth_id: '%s', full_name: '%s', sidebarOpen: false, sidebarCollapsed: false, darkMode: (localStorage.getItem('darkMode') === 'true' ? true : false), isMobile: window.innerWidth < 768, colorOptions: %s, task_priorities: %s, project_statuses: %s, task_statutes: %s, }", strings.Trim(user.ID," "), user.FullName, string(utils.MustJSON(services.GetColorOptions())), string(utils.MustJSON(services.GetTaskPriorities())), string(utils.MustJSON(services.GetProjectStatuses())), string(utils.MustJSON(services.GetTaskStatuses())))}
			x-init="
				$watch('darkMode', val => {
					localStorage.setItem('darkMode', val);
					if (val) {
						document.documentElement.classList.add('dark');
					} else {
						document.documentElement.classList.remove('dark');
					}
				});
				if (darkMode) {
					document.documentElement.classList.add('dark');
				}
				window.addEventListener('resize', () => {
					let currentSize = isMobile;
					isMobile = window.innerWidth < 768;
					if (!isMobile) sidebarOpen = false;
					
					if (currentSize != isMobile) {
						htmx.ajax('GET', '/workspace-switcher', {target: '#workspace-switcher', swap: 'innerHTML', indicators: []})
					}
					
				});
			"
		>
			<div class="flex h-screen">
				<!-- Desktop Sidebar -->
				<div 
					class="hidden md:flex flex-col bg-card border-r border-border transition-all duration-300 ease-in-out"
					:class="sidebarCollapsed ? 'w-16' : 'w-64'"
				>
					@Sidebar(false)
				</div>

				<!-- Main Content -->
				<div class="flex-1 flex flex-col min-w-0">
					@Header(services.GetUser(user))

					<!-- Page Content -->
					<main class="flex-1 p-6 overflow-y-auto">
						<div id="content" class="w-full h-full" >
							for _, c := range content {
								@c
							}
						</div>
					</main>
				</div>
				
				<!-- Mobile Sidebar Overlay -->
				<div 
					x-show="sidebarOpen && isMobile"
					x-transition:enter="transition-opacity ease-linear duration-300"
					x-transition:enter-start="opacity-0"
					x-transition:enter-end="opacity-100"
					x-transition:leave="transition-opacity ease-linear duration-300"
					x-transition:leave-start="opacity-100"
					x-transition:leave-end="opacity-0"
					class="fixed inset-0 z-40 bg-black bg-opacity-50 md:hidden"
					@click="sidebarOpen = false"
				></div>

				<!-- Mobile Sidebar -->
				<div 
					x-show="sidebarOpen && isMobile"
					x-transition:enter="transition ease-in-out duration-300 transform"
					x-transition:enter-start="-translate-x-full"
					x-transition:enter-end="translate-x-0"
					x-transition:leave="transition ease-in-out duration-300 transform"
					x-transition:leave-start="translate-x-0"
					x-transition:leave-end="-translate-x-full"
					class="fixed inset-y-0 left-0 z-50 w-64 bg-card border-r border-border md:hidden"
				>
					@Sidebar(true)
				</div>
				@components.Loader("loader")
			</div>
			@features.CreateWorkspace("w-96", nil) 
			@BaseScript(os.Getenv("APP_NAME"))
			<div id="toaster"></div> 
			<script>
				function workspaceSwitcher(defaultWs) {
					return {
						openSelect: false,
						selected: { value: "", label: "", color: "" },
						init() {
							// initial
							this.loadFromStorage(defaultWs);

							// listen kalau ada perubahan dari luar (tab lain / script lain)
							window.addEventListener("storage", (e) => {
								if (e.key === "currentWorkspace") {
									this.loadFromStorage(defaultWs);
								}
							});
						},
						loadFromStorage(fallback) {
							let saved = localStorage.getItem("currentWorkspace");
							if (saved) {
								try { this.selected = JSON.parse(saved); } 
								catch(e) { this.selected = fallback; }
							} else {
								this.selected = fallback;
								localStorage.setItem("currentWorkspace", JSON.stringify(fallback));
							}
						},
						selectWorkspace(ws) {
							this.selected = ws;
							localStorage.setItem("currentWorkspace", JSON.stringify(ws));
							this.openSelect = false;
						}
					}
				}
				
				lucide.createIcons();
			</script>
		</body>
	</html>
}


script BaseScript(appName string) {

	
	document.addEventListener("DOMContentLoaded", () => {
		lucide.createIcons();
	});

	// or htmx:afterSwap
	document.body.addEventListener("htmx:afterOnLoad", (e) => {
		if (e.detail.target.id === "content") {
			const newTitle = document.querySelector("#content [data-title]")?.dataset.title;
			if (newTitle) document.title = newTitle !== "" ? newTitle+" - "+appName : appName;
		}
		
		if (e.detail.target.id === "toaster") {
			document.querySelector("#toaster")
				.insertAdjacentHTML("beforeend", e.detail.xhr.responseText);						
		}
		lucide.createIcons();
	});

	document.body.addEventListener("htmx:afterOnLoad", (e) => {
		if (e.detail.target.id === "toaster") {
			document.querySelector("#toaster")
				.insertAdjacentHTML("beforeend", e.detail.xhr.responseText);						
		}
		lucide.createIcons();
	});
	
	document.body.addEventListener("htmx:responseError", function(e) {
		if (e.detail.target.id === "content") {
			document.querySelector("#toaster")
				.insertAdjacentHTML("beforeend", e.detail.xhr.responseText);
		}
	});

	document.addEventListener("alpine:init", () => {
		Alpine.store("dropdown", {
			openId: null,
			isOpen(id) { return this.openId === id },
			toggle(id) { this.openId = this.openId === id ? null : id },
			close() { this.openId = null }
		});
		Alpine.store("modal", {
			active: null,
			open(id) {
				this.active = id
				document.body.classList.add("overflow-hidden")
				document.body.dispatchEvent(new CustomEvent("modal:opened", {
					detail: { id }
				}))
			},
			close(id) {
				if (this.active === id) {
					this.active = null
					document.body.classList.remove("overflow-hidden")
					// Emit event global agar listener lain bisa reset form
					document.body.dispatchEvent(new CustomEvent("modal:closed", {
						detail: { id }
					}))
				}
			},
			isOpen(id) {
				return this.active === id
			}
		});
		Alpine.store("workspace", {
			current: localStorage.getItem("workspace") || "",
			set(val) {
				this.current = val
				localStorage.setItem("workspace", val)
			}
		});
		Alpine.store("navigation", {
			currentPath: window.location.pathname,
			setPath(path) {
				this.currentPath = path
			}
		})

		// Update kalau user pakai tombol back/forward
		window.addEventListener("popstate", () => {
			Alpine.store("navigation").setPath(window.location.pathname)
		})

		// Update kalau htmx ganti url
		document.body.addEventListener("htmx:afterSwap", (e) => {
			if (e.detail.target.id === "content") {
				Alpine.store("navigation").setPath(window.location.pathname)
			}
		})
	});
}