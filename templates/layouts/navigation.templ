package layouts

import (
    "etop/templates/components/ui"
    "etop/models"
)

templ Navigation() {
    <ul class="space-y-2">
        for _, menu := range models.GetMenu() {
            <li>
                <a 
                    hx-post={menu.Href}
                    hx-target="#content"
                    hx-swap="innerHTML"
                    hx-push-url="true"
                    class="flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-accent hover:text-accent-foreground transition-colors cursor-pointer"
                    :class="sidebarCollapsed && !isMobile ? 'justify-center' : ''"
                    @click="if (isMobile) sidebarOpen = false"
                >                  
                    <div x-show="!sidebarCollapsed || isMobile" class="w-5 h-5" data-lucide={menu.Icon} />
                    <span x-show="!sidebarCollapsed || isMobile">{menu.Label}</span>
                    @ui.Tooltip(menu.Label, "mt-0 ml-4", templ.Attributes{}) {
                        <div class="w-5 h-5" data-lucide={menu.Icon} x-show="sidebarCollapsed && !isMobile" />
                    }  
                </a>
            </li>
        }
    </ul>
}