package layouts

import (
	"os"
)

// Sidebar Layout
templ Sidebar() {
	<div class="flex flex-col h-full">
		<!-- Logo -->
		<div class="h-16 min-h-16 flex items-center border-b border-border" :class="sidebarCollapsed && !isMobile ? 'px-4' : 'px-6'">
			<div class="flex items-center gap-1.5" x-show="!sidebarCollapsed || isMobile">
				<div class="w-8 h-8 bg-green-600 dark:bg-gray-600 rounded-lg flex items-center justify-center">
					<span class="text-3xl text-primary-foreground font-semibold" style="margin-top: -6px" >{os.Getenv("APP_NAME")[0:1]}</span>
				</div>
				<span class="font-bold text-2xl pb-1.6 pt-0">{os.Getenv("APP_NAME")[1:len(os.Getenv("APP_NAME"))]}</span>
			</div>
			<div class="w-8 h-8 bg-green-600 dark:bg-gray-600 rounded-lg flex items-center justify-center"x-show="sidebarCollapsed && !isMobile">
				<span class="text-3xl text-primary-foreground font-semibold" style="margin-top: -6px" >{os.Getenv("APP_NAME")[0:1]}</span>
			</div>
		</div>
		<div id="workspace-switcher-mobile" x-show="isMobile" class="p-2 pb-0" />
		<!-- Navigation -->
		<nav class="flex-1" :class="sidebarCollapsed && !isMobile ? 'p-2' : 'p-4'" :class="isMobile ? 'pt-0' : '' ">
			@Navigation()
		</nav>
	</div>
}