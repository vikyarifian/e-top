templ CreateDeptForm() {
    <div
        x-data="{
                    name: '',
                    description: '',
                    color: '',
                    selectedColor: '',
                    dept_head_id: '',
                    members: [],
                    nameError: '',
                    descriptionError : '',
                    colorError: '',
                    validateName() {
                        this.nameError = (this.name.trim() === '')
                            ? 'Name is required'
                            : '';
                        this.name = this.name.charAt(0).toUpperCase() + this.name.slice(1);
                    },
                    validateColor() {
                        this.colorError = (this.color.trim() === '')
                            ? 'Color is required'
                            : '';
                    },
                    validateForm(e) {
                        e.preventDefault();
                        this.validateName();
                        //this.validateColor();
                        
                        if (this.nameError || this.validateColor()) {
                            return; 
                        }
                    },
                    resetForm() {
                        this.tags = [];
                        this.name = '';
                        this.description = '';
                        this.color = '';
                        this.dept_head_id= '';
                        this.selectedColor = '';
                        this.members = [];
                        this.nameError = '';
                        this.descriptionError = '';
                        this.colorError = '';
                    },
                    init() {
                        document.body.addEventListener('htmx:afterRequest', (evt) => {
                            if (evt.detail.successful && evt.detail.elt.id === 'create-department-form') {
                                $store.modal.close('create-department-modal');
                                this.resetForm();
                                htmx.ajax('GET', '/department-switcher', {target: '#department-switcher', swap: 'innerHtml'})
                                if (window.location.pathname === '/departments') {
                                    htmx.ajax('POST', '/departments', { 
                                        target: '#content', 
                                        swap: 'innerHTML' 
                                    })
                                }
                            }
                        });

                        document.body.addEventListener('modal:closed', (evt) => {
                            if (evt.detail.id === 'create-department-modal') {
                                this.resetForm();
                            }
                        });
                    }
                }"
    >
        @ui.Form("/department", "post", "", templ.Attributes{
                "id":"create-department-form",
                "hx-target": "#toaster",
                "hx-swap": "innerHtml",
                "hx-disabled-elt":"#create-button,#name,#description,#colorOption",
                "x-ref": "form",
                "@submit.prevent":"validateForm($event)",
        }) {
            @ui.FormItem("", nil) {
                @ui.FormLabel("name", "Name", "", nil)
                @ui.FormControl("name", "name", "text", "Department Name", "", "", templ.Attributes{
                    "autocomplete":"name",
                    "x-model": "name",
                    "@blur": "validateName",
                })
                @ui.FormMessage("", "", templ.Attributes{
                        "x-show": "nameError != ''",
                        "x-text": "nameError",
                    },
                )
            }
            @ui.FormItem("", nil) {
                @ui.FormLabel("description", "Description", "", nil)
                @ui.FormControl("description", "description", "textarea", "Department Description", "", "", templ.Attributes{
                    "autocomplete":"description",
                    "x-model": "description",
                    "@blur": "description=description.charAt(0).toUpperCase() + description.slice(1)",
                })
                @ui.FormMessage("", "", templ.Attributes{
                        "x-show": "descriptionError != ''",
                        "x-text": "descriptionError",
                    },
                )
            }
            @ui.FormItem("", nil) {
                @ui.FormLabel("", "Color", "", nil)
                <div id="colorOption"
                    class="flex items-center space-x-3 mt-2"
                >
                    <template x-for="color in colorOptions" :key="color.name">
                        <button 
                            type="button"
                            class="h-6 w-6 rounded-full transition ring-2 ring-offset-2 ring-offset-white dark:ring-offset-neutral-900"
                            :class="[
                                color.class, 
                                selectedColor === color.class ? 'ring-primary dark:ring-white scale-110' : 'ring-transparent'
                            ]"
                            @click="selectedColor = color.class;"
                            :title="color.class"
                        ></button>
                    </template>

                    <!-- Hidden input buat form -->
                    <input type="hidden" id="color" name="color" x-model="color" :value="selectedColor">
                    @ui.FormMessage("", "", templ.Attributes{
                            "x-show": "selectedColor === ''",
                            "x-text": "colorError",
                        },
                    )
                </div>
            }
            @ui.FormItem("mb-4", nil) {
                @ui.FormLabel("dept_head_id", "Manager", "", nil)
                @components.ManagerInput("dept_head_id",
                    "dept_head_id",
                    "Type a user...",
                    []models.User{},  
                    services.GetNonManager(),
                    "",
                    nil,
                )
                @ui.FormMessage("", "", templ.Attributes{},
                )
            }
            @ui.FormItem("", nil) {
                @ui.FormLabel("members", "Members", "", nil)
                @components.MemberInput("members",
                    "members",
                    "Type a member...",
                    []models.UserRole{},  
                    services.GetUserWithoutDept(),
                    "",
                    nil,
                )
                @ui.FormMessage("", "", templ.Attributes{},
                )
            }
            @components.DottedSeparator("", "#d4d4d8", "2px", "", "", "horizontal")
            <div class="flex justify-end items-end">
                @ui.Button("create-button", "", "", "", "Create", "", templ.Attributes{"type": "submit"}) 
            </div>
        }
    </div>
}

templ EditDept(class string) {
    @components.ResponsiveModal("edit-department-modal", "Edit Department", class) {
        <div id="edit-department-form" 
            x-data="{
                init() {
                    document.body.addEventListener('modal:opened', (evt) => {
                        if (evt.detail.id === 'edit-department-modal') {
                            htmx.ajax('GET', '/edit-department-form?dept_id='+window.dept_id, {target: '#edit-department-form', swap: 'innerHtml'})
                        }
                    });
                    document.body.addEventListener('modal:closed', (evt) => {
                        if (evt.detail.id === 'edit-department-modal') {
                            document.getElementById('edit-department-form').innerHTML = '';
                        }
                    });
                }
            }"
        >
        </div>
    }
}

templ EditDeptForm(dept models.Department) {
    <div
        x-data="{
                    dept: {},
                    selectedColor: '',
                    nameError: '',
                    descriptionError : '',
                    colorError: '',
                    members: [],
                    validateName() {
                        this.nameError = (this.dept.name.trim() === '')
                            ? 'Name is required'
                            : '';
                        this.dept.name = this.dept.name.charAt(0).toUpperCase() + this.dept.name.slice(1);
                    },
                    validateColor() {
                        this.colorError = (this.dept.color.trim() === '')
                            ? 'Color is required'
                            : '';
                    },
                    validateForm(e) {
                        e.preventDefault();
                        this.validateName();
                        if (this.nameError || this.validateColor()) {
                            return; 
                        }
                    },
                    init() {
                        document.body.addEventListener('htmx:afterRequest', (evt) => {
                            if (evt.detail.successful && evt.detail.elt.id === 'edit-department-form') {
                                $store.modal.close('edit-department-modal');
                                htmx.ajax('POST', '/settings?tab=departments', {
                                    target: '#content',
                                    swap: 'innerHTML'
                                })
                            }
                        });
                    }
                }"
        x-init={fmt.Sprintf("dept=%s;selectedColor='%s'", string(utils.MustJSON(dept)), dept.Color)}
    >
        @ui.Form("/department", "put", "", templ.Attributes{
                "id":"edit-department-form",
                "hx-target": "#toaster",
                "hx-swap": "innerHtml",
                "hx-disabled-elt":"#edit-button,#name,#description,#colorOption",
                "x-ref": "form",
                "@submit.prevent":"validateForm($event)",
        }) {
            <input id="dept_id" type="hidden" name="dept_id" x-model="dept.id" />
            @ui.FormItem("", nil) {
                @ui.FormLabel("name", "Name", "", nil)
                @ui.FormControl("name", "name", "text", "Department Name", dept.Name, "", templ.Attributes{
                    "autocomplete":"name",
                    "x-model": "dept.name",
                    "@blur": "validateName",
                })
                @ui.FormMessage("", "", templ.Attributes{
                        "x-show": "nameError != ''",
                        "x-text": "nameError",
                    },
                )
            }
            @ui.FormItem("", nil) {
                @ui.FormLabel("description", "Description", "", nil)
                @ui.FormControl("description", "description", "textarea", "Department Description", dept.Description, "", templ.Attributes{
                    "autocomplete":"description",
                    "x-model": "dept.description",
                    "@blur": "dept.description=dept.description.charAt(0).toUpperCase() + dept.description.slice(1)",
                })
                @ui.FormMessage("", "", templ.Attributes{
                        "x-show": "descriptionError != ''",
                        "x-text": "descriptionError",
                    },
                )
            }
            @ui.FormItem("", nil) {
                @ui.FormLabel("", "Color", "", nil)
                <div id="colorOption"
                    class="flex items-center space-x-3 mt-2"
                >
                    <template x-for="color in colorOptions" :key="color.name">
                        <button 
                            type="button"
                            class="h-6 w-6 rounded-full transition ring-2 ring-offset-2 ring-offset-white dark:ring-offset-neutral-900"
                            :class="[
                                color.class, 
                                selectedColor === color.class ? 'ring-primary dark:ring-white scale-110' : 'ring-transparent'
                            ]"
                            @click="selectedColor = color.class;"
                            :title="color.class"
                        ></button>
                    </template>
                    <input type="hidden" id="color" name="color" x-model="dept.color" :value="selectedColor">
                    @ui.FormMessage("", "", templ.Attributes{
                            "x-show": "selectedColor === ''",
                            "x-text": "colorError",
                        },
                    )
                </div>
            }
            @ui.FormItem("mb-4", nil) {
                @ui.FormLabel("dept_head_id", "Manager", "", nil)
                @components.ManagerInput("dept_head_id",
                    "dept_head_id",
                    "Type a user...",
                    []models.User{dept.DeptHead},
                    services.GetNonManager(),
                    "",
                    nil,
                )
            }
            @ui.FormItem("", nil) {
                @ui.FormLabel("members", "Members", "", nil)
                <div
                    x-data="{
                        mems: [],
                        init() {
                            this.mems.forEach(m => {
                                this.members.push({
                                    user_id: m.user_id,
                                    role: m.role,
                                });
                            });
                        },
                        updateRole(userId, role) {
                            let m = [...this.members].find(x => x.user_id === userId);
                            if (m) m.role = role;
                        }
                    }"
                    class="pl-2 space-y-2 flex flex-col"
                    x-init={fmt.Sprintf("mems=%s;init();", string(utils.MustJSON(dept.Members)))}
                >
                    for i, member := range dept.Members {
                        <div class="inline-flex items-center gap-2">
                            <span class="w-full flex items-center gap-2">
                                @ui.Avatar(member.User.FullName, member.User.Color, "sm", "h-8 w-8 border-2 border-background overflow-hidden cursor-pointer -space-x-2 -ml-2", nil) 
                                {member.User.FullName}
                            </span>
                            <select id={fmt.Sprintf("role-%v", i)} 
                                @change={fmt.Sprintf("updateRole('%s', $event.target.value)", member.User.ID)}
                                class="px-1 py-0.5 text-xs rounded-md border dark:bg-accent"
                                if strings.Trim(member.Role, " ") == "MANAGER" {
                                    disabled
                                }
                            >
                                if strings.Trim(member.Role, " ") == "MANAGER" {
                                    <option value="MANAGER" selected>Manager</option>
                                }
                                <option value="MEMBER"
                                    if strings.Trim(member.Role, " ") == "MEMBER" {
                                        selected
                                    }
                                >Member</option>
                            </select>
                        </div>
                    }
                    <input
                        type="hidden"
                        name="members" 
                        :value="JSON.stringify(members)"
                    />
                </div>
            }
            @components.DottedSeparator("", "#d4d4d8", "2px", "", "", "horizontal")
            <div class="flex justify-end items-end">
                @ui.Button("edit-button", "", "", "", "Save", "", templ.Attributes{"type": "submit"}) 
            </div>
        }
    </div>
}