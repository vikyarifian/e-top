        >
        </div>
    }
}

templ CreateUserForm() {
    <div
        x-data="{
                    full_name: '',
                    username: '',
                    email: '',
                    password: '',
                    level: 'USER',
                    color: '',
                    selectedColor: '',
                    nameError: '',
                    usernameError: '',
                    emailError: '',
                    passwordError: '',
                    validateName() {
                        this.nameError = (this.full_name.trim() === '')
                            ? 'Name is required'
                            : '';
                        this.full_name = this.full_name.charAt(0).toUpperCase() + this.full_name.slice(1);
                    },
                    validateUsername() {
                        this.usernameError = (this.username.trim() === '')
                            ? 'Username is required'
                            : '';
                    },
                    validateEmail() {
                        this.emailError = (this.email.trim() === '')
                            ? 'Email is required'
                            : '';
                    },
                    validatePassword() {
                        this.passwordError = (this.password.trim() === '')
                            ? 'Password is required'
                            : '';
                    },
                    validateForm(e) {
                        e.preventDefault();
                        this.validateName();
                        this.validateUsername();
                        this.validateEmail();
                        this.validatePassword();
                        if (this.nameError || this.usernameError || this.emailError || this.passwordError) {
                            return; 
                        }
                    },
                    resetForm() {
                        this.full_name = '';
                        this.username = '';
                        this.email = '';
                        this.password = '';
                        this.level = 'USER';
                        this.color = '';
                        this.selectedColor = '';
                        this.nameError = '';
                        this.usernameError = '';
                        this.emailError = '';
                        this.passwordError = '';
                    },
                    init() {
                        document.body.addEventListener('htmx:afterRequest', (evt) => {
                            if (evt.detail.successful && evt.detail.elt.id === 'create-user-form') {
                                $store.modal.close('create-user-modal');
                                this.resetForm();
                                htmx.ajax('POST', '/settings?tab=users', {
                                    target: '#content',
                                    swap: 'innerHTML'
                                })
                            }
                        });
                        document.body.addEventListener('modal:closed', (evt) => {
                            if (evt.detail.id === 'create-user-modal') {
                                this.resetForm();
                            }
                        });
                    }
                }"
    >
        @ui.Form("/user", "post", "", templ.Attributes{
                "id":"create-user-form",
                "hx-target": "#toaster",
                "hx-swap": "innerHtml",
                "hx-disabled-elt":"#create-user-button,#full_name,#username,#email,#password",
                "x-ref": "form",
                "@submit.prevent":"validateForm($event)",
        }) {
            @ui.FormItem("", nil) {
                @ui.FormLabel("full_name", "Name", "", nil)
                @ui.FormControl("full_name", "full_name", "text", "Full Name", "", "", templ.Attributes{
                    "autocomplete":"name",
                    "x-model": "full_name",
                    "@blur": "validateName",
                })
                @ui.FormMessage("", "", templ.Attributes{
                        "x-show": "nameError != ''",
                        "x-text": "nameError",
                    },
                )
            }
            @ui.FormItem("", nil) {
                @ui.FormLabel("username", "Username", "", nil)
                @ui.FormControl("username", "username", "text", "Username", "", "", templ.Attributes{
                    "autocomplete":"username",
                    "x-model": "username",
                    "@blur": "validateUsername",
                })
                @ui.FormMessage("", "", templ.Attributes{
                        "x-show": "usernameError != ''",
                        "x-text": "usernameError",
                    },
                )
            }
            @ui.FormItem("", nil) {
                @ui.FormLabel("email", "Email", "", nil)
                @ui.FormControl("email", "email", "text", "Email", "", "", templ.Attributes{
                    "autocomplete":"email",
                    "x-model": "email",
                    "@blur": "validateEmail",
                })
                @ui.FormMessage("", "", templ.Attributes{
                        "x-show": "emailError != ''",
                        "x-text": "emailError",
                    },
                )
            }
            @ui.FormItem("", nil) {
                @ui.FormLabel("password", "Password", "", nil)
                @ui.FormControl("password", "password", "password", "Password", "", "", templ.Attributes{
                    "autocomplete":"new-password",
                    "x-model": "password",
                    "@blur": "validatePassword",
                })
                @ui.FormMessage("", "", templ.Attributes{
                        "x-show": "passwordError != ''",
                        "x-text": "passwordError",
                    },
                )
            }
            @ui.FormItem("", nil) {
                @ui.FormLabel("level", "Level", "", nil)
                <select id="level" name="level" x-model="level" class="flex h-11 w-full block appearance-none rounded-md border border-input px-3 py-2 text-sm shadow-sm dark:bg-accent focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring">
                    <option value="USER">User</option>
                    <option value="ADMIN">Admin</option>
                </select>
            }
            @ui.FormItem("", nil) {
                @ui.FormLabel("", "Color", "", nil)
                <div id="colorOption"
                    class="flex items-center space-x-3 mt-2"
                >
                    <template x-for="color in colorOptions" :key="color.name">
                        <button 
                            type="button"
                            class="h-6 w-6 rounded-full transition ring-2 ring-offset-2 ring-offset-white dark:ring-offset-neutral-900"
                            :class="[
                                color.class, 
                                selectedColor === color.class ? 'ring-primary dark:ring-white scale-110' : 'ring-transparent'
                            ]"
                            @click="selectedColor = color.class;"
                            :title="color.class"
                        ></button>
                    </template>
                    <input type="hidden" id="color" name="color" x-model="color" :value="selectedColor">
                </div>
            }
            @components.DottedSeparator("", "#d4d4d8", "2px", "", "", "horizontal")
            <div class="flex justify-end items-end">
                @ui.Button("create-user-button", "", "", "", "Create", "", templ.Attributes{"type": "submit"}) 
            </div>
        }
    </div>
}

