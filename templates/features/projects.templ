package features

import (
	"fmt"
    "time"
    "strings"
	// "strconv"

	"etop/utils"
    "etop/models"
	"etop/services"
    "etop/templates/components"
    "etop/templates/components/ui"
)

templ Project(role string, project models.Project) {
    if role == "OWNER" || role == "ADMIN"  || role == "MEMBER" {
        @CreateTask(project.ID, "PROJECT", "w-[900px]", nil)
    }
    if role == "OWNER" || role == "ADMIN" {
        @EditProject(project.ID, "w-[900px]", nil) 
    }
    <div data-title="Project" class="space-y-6">
        <div class="flex items-center justify-between">
            <div>
                // @components.BackButton("mb-2", templ.Attributes{
                //     "type": "button",
                //     "hx-post": fmt.Sprintf("/workspaces?id=%s",project.WorkspaceID),
                //     "hx-target": "#content",
                //     "hx-swap": "innerHTML",
                //     "hx-push-url": "true",
                //     "hx-indicator": ".htmx-loader,.loaded-content",})
                <div class="flex items-center justify-between space-y-0">
                    <div class="p-1 mr-2">
                        <div class={"w-7 h-7 p-2 rounded-md text-white flex items-center justify-center text-sm font-semibold " , project.Workspace.Color}>
                            {strings.ToUpper(project.Workspace.Name[0:1])}
                        </div>
                    </div>
                    <h2 x-show="!isMobile" class="text-3xl font-semibold text-muted-foreground hover:opacity-75 transition cursor-pointer"
                        hx-post={fmt.Sprintf("/workspaces?id=%s",project.WorkspaceID)}
                        hx-target="#content"
                        hx-swap="innerHTML"
                        hx-push-url="true"
                        hx-indicator=".htmx-loader,.loaded-content"
                    >
                        {project.Workspace.Name}
                    </h2>
                    <svg x-show="!isMobile" class="size-4 mr-2 ml-2 pt-1 text-muted-foreground" data-lucide="chevron-right" />
                    <h2 class="text-3xl font-bold tracking-tight">{project.Title}</h2>
                </div>
                <p class="text-muted-foreground p-1">{project.Description}</p>
            </div>

            <div class="flex flex-col sm:flex-row gap-3">
                <div class="flex items-center gap-2 min-w-32">
                    <div class="space-y-1 text-muted-foreground mr-1">
                        <div class="flex justify-between text-xs">
                            <div class="text-xs">
                                Progress: {project.Progress}%
                            </div>
                        </div>
                        @ui.Progress(project.ID, project.Progress, 100, "sm", "", templ.Attributes{"data-note":"x"})
                    </div>
                    if role == "OWNER" || role == "ADMIN"  || role == "MEMBER" {
                        <div>
                            @ui.Button("create-task", "", "sm", "", "", "", templ.Attributes{
                                "type": "button",
                                "@click":"$store.modal.open('create-task-modal')",
                            }) {
                                <i data-lucide="circle-plus" class="w-4 h-4 "></i><span x-show="!isMobile" x-text="`${isMobile ? '' : 'Add Task'}`"></span>
                            }
                        </div>
                    }
                    if role == "OWNER" || role == "ADMIN" {
                        <div>
                            @ui.Button("project-settings", "outline", "sm", "", "", "", templ.Attributes{
                                "type": "button",
                                "@click":"$store.modal.open('edit-project-modal')",
                            }) {
                                <i data-lucide="settings" class="w-4 h-4 "></i>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
        
        <div class="flex items-center gap-2">
            <span class="text-sm text-muted-foreground mr-2">Contributors : </span>
            <div class="flex">
                for _,contributor := range project.Members {
                    @ui.Tooltip(strings.Split(contributor.User.FullName," ")[0]+" ("+contributor.Role+")", "w-[180px]", nil) {
                        @ui.Avatar(contributor.User.FullName, contributor.User.Color, "sm", "h-8 w-8 border-2 border-background overflow-hidden cursor-pointer -space-x-2 -ml-2", nil) 
                    }
                }
            </div>
        </div>

        <!-- Stats Cards -->
        <div 
            class="flex-1 w-full h-full border rounded-lg border-border bg-card text-card-foreground shadow-sm p-4 transition-all duration-300 shadow-md"
        >
            @ui.Tabs("tabs", "table", "", nil) {
                <div className="h-full flex flex-col overflow-auto p-4">                
                    <div className="flex flex-col gap-y-2 lg:flex-row justify-between items-center">
                        @ui.TabsList("w-full lg:w-auto mb-4", nil) {
                            @ui.TabsTrigger("table", "Table", "h-8 w-full lg:w-auto", nil)  
                            @ui.TabsTrigger("kanban", "Kanban", "h-8 w-full lg:w-auto", nil)  
                            @ui.TabsTrigger("calendar", "Calendar", "h-8 w-full lg:w-auto", nil)  
                        }
                        <div class="mb-4">
                            @components.DottedSeparator("", "#d4d4d8", "2px", "", "", "horizontal")
                        </div>
                        @ui.TabsContent("table", "overflow-auto mt-0 scrollbar-thin", nil) {
                            if len(project.Tasks) == 0 {
                                @components.NoData("No tasks found", "Create your first task", nil) {
                                    @ui.Button("create-task", "outline", "xs", "circle-plus", "Create Task", "", templ.Attributes{
                                        "type": "button",
                                        "@click":"$store.modal.open('create-task-modal')",
                                    })
                                }
                            } else {
                                <div class="rounded-md border">
                                    <div class="relative w-full overflow-auto scrollbar-thin">
                                        @ui.Table("w-full caption-bottom text-sm", nil) {
                                            @ui.TableHeader("", nil) {
                                                @ui.TableRow("", nil) {
                                                    @ui.TableHead("", nil) {
                                                        @ui.Button("title-sort", "ghost", "sm", "", "", "", templ.Attributes{
                                                            "type": "button",
                                                        }) {
                                                            Title <i data-lucide="arrow-up-down" class="w-4 h-4 mr-1"></i>
                                                        }
                                                    }
                                                    @ui.TableHead("", nil) {
                                                        @ui.Button("assignee-sort", "ghost", "sm", "", "", "", templ.Attributes{
                                                            "type": "button",
                                                        }) {
                                                            Assignee <i data-lucide="arrow-up-down" class="w-4 h-4 mr-1"></i>
                                                        }
                                                    }
                                                    @ui.TableHead("", nil) {
                                                        @ui.Button("due-sort", "ghost", "sm", "", "", "", templ.Attributes{
                                                            "type": "button",
                                                        }) {
                                                            Due Date <i data-lucide="arrow-up-down" class="w-4 h-4 mr-1"></i>
                                                        }
                                                    }
                                                    @ui.TableHead("", nil) {
                                                        @ui.Button("priority-sort", "ghost", "sm", "", "", "", templ.Attributes{
                                                            "type": "button",
                                                        }) {
                                                            Priority <i data-lucide="arrow-up-down" class="w-4 h-4 mr-1"></i>
                                                        }
                                                    }
                                                    @ui.TableHead("", nil) {
                                                        @ui.Button("status-sort", "ghost", "sm", "", "", "", templ.Attributes{
                                                            "type": "button",
                                                        }) {
                                                            Status <i data-lucide="arrow-up-down" class="w-4 h-4 mr-1"></i>
                                                        }
                                                    }
                                                    @ui.TableHead("text-right w-1", nil)
                                                }
                                            }
                                            @ui.TableBody("", nil) {
                                                for _, task := range project.Tasks {
                                                    @ui.TableRow("cursor-pointer", templ.Attributes{
                                                        "hx-post": "/tasks?id="+task.ID,
                                                        "hx-target": "#content",
                                                        "hx-swap": "innerHtml",
                                                        "hx-push-url": "true",
                                                        "hx-indicator": ".htmx-loader,.loaded-content",
                                                    }) {
                                                        @ui.TableCell("py-1.5 px-2", nil) {
                                                            {task.Title}
                                                        }
                                                        @ui.TableCell("py-1.5 px-2", nil) {
                                                            // if len(task.Assignees) > 0 {
                                                                <div class="flex justify-start">
                                                                    if task.UserID != "" {
                                                                        @ui.Avatar(task.Assignee.Username, task.Assignee.Color, "xs", "h-4 w-4 mr-2", templ.Attributes{})
                                                                        {task.Assignee.FullName}
                                                                    } else {
                                                                        {"Unassigned"}
                                                                    }                                                           
                                                                    // @ui.Tooltip(func() string {
                                                                    //     if task.Assignee != nil {
                                                                    //         assignees := ""
                                                                    //         for i, assignee := range task.Assignees {
                                                                    //             assignees += strconv.Itoa(i+1)+". "+assignee.User.FullName+"\n"
                                                                    //         }
                                                                    //         return assignees
                                                                    //     }
                                                                    //     return "Unassigned"
                                                                    // }(), "w-64 z-39", nil) {
                                                                    //     if len(task.Assignees) > 1 {
                                                                    //         <span class="text-muted-foreground cursor-pointer">&nbsp; and {len(task.Assignees)-1} more</span>
                                                                    //     }
                                                                    // }
                                                                </div>
                                                            // } 
                                                        }
                                                        @ui.TableCell("py-1.5 px-2", templ.Attributes{
                                                            ":class": fmt.Sprintf("%v<=3?'text-red-500':(%v<=7?'text-orange-500':(%v<=14?'text-yellow-600':'text-muted-foreground'))", (utils.TimeDiff(time.Now(),*task.DueDate).Hours()/24), (utils.TimeDiff(time.Now(),*task.DueDate).Hours()/24), (utils.TimeDiff(time.Now(),*task.DueDate).Hours()/24)),
                                                        }) {
                                                            if task.DueDate != nil {
                                                                {task.DueDate.Format("Mon, 02 Jan 2006")}
                                                            } 
                                                        }
                                                        @ui.TableCell("py-1.5 px-2", nil) {
                                                            @ui.Tooltip(task.Priority.Label, "", nil){
                                                            <div class="flex items-center">
                                                                for i := 1; i <= 3; i++ {
                                                                    if i <= task.Priority.Level {
                                                                        <svg
                                                                            xmlns="http://www.w3.org/2000/svg"
                                                                            class="w-6 h-6 text-yellow-400 fill-yellow-400 p-0.4 rounded"
                                                                            fill="none"
                                                                            viewBox="0 0 24 24"
                                                                            stroke="currentColor"
                                                                            stroke-width="1.5"
                                                                        >
                                                                            <path
                                                                                stroke-linecap="round"
                                                                                stroke-linejoin="round"
                                                                                d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l2.037 6.272h6.594c.969 0 1.371 1.24.588 1.81l-5.335 3.876 2.037 6.272c.3.921-.755 1.688-1.54 1.118L12 18.347l-5.332 3.928c-.784.57-1.838-.197-1.539-1.118l2.037-6.272-5.335-3.876c-.783-.57-.38-1.81.588-1.81h6.594z"
                                                                            />
                                                                        </svg>
                                                                    } else {
                                                                        <svg
                                                                            xmlns="http://www.w3.org/2000/svg"
                                                                            class="w-6 h-6 text-gray-300 p-0.4 rounded"
                                                                            fill="none"
                                                                            viewBox="0 0 24 24"
                                                                            stroke="currentColor"
                                                                            stroke-width="1.5"
                                                                        >
                                                                            <path
                                                                                stroke-linecap="round"
                                                                                stroke-linejoin="round"
                                                                                d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l2.037 6.272h6.594c.969 0 1.371 1.24.588 1.81l-5.335 3.876 2.037 6.272c.3.921-.755 1.688-1.54 1.118L12 18.347l-5.332 3.928c-.784.57-1.838-.197-1.539-1.118l2.037-6.272-5.335-3.876c-.783-.57-.38-1.81.588-1.81h6.594z"
                                                                            />
                                                                        </svg>
                                                                    }
                                                                }
                                                            </div>
                                                            }
                                                            // @ui.Badge(task.Priority.Label, task.Priority.Label, task.Priority.Color, templ.Attributes{})
                                                        }
                                                        @ui.TableCell("py-1.5 px-2", nil) {
                                                            <span class={fmt.Sprintf("text-xs rounded-md pl-2 pr-2 py-0.5 %s", task.Status.Color)} 
                                                            >{task.Status.Label}</span>
                                                            // @ui.Badge(task.Priority, "", "", templ.Attributes{
                                                            //     ":class": fmt.Sprintf("task_statutes.filter(c=>c.status.trim().toUpperCase()==='%s'.trim().toUpperCase())[0].color", task.Status),
                                                            //     "x-text": fmt.Sprintf("task_statutes.filter(c=>c.status.trim().toUpperCase()==='%s'.trim().toUpperCase())[0].label", task.Status),
                                                            // })
                                                        }
                                                        // @ui.TableCell("py-1.5 px-2 w-1 z-80", nil) {
                                                        //     @ui.Dropdown(strconv.Itoa(task.No), "", nil) {
                                                        //         @ui.DropdownTrigger("p-1", nil) {
                                                        //             <div data-lucide="ellipsis-vertical" class="w-4 h-4" />
                                                        //         }
                                                        //         @ui.DropdownContent("", nil) {
                                                        //             @ui.DropdownItem(false, false, "h-10 flex items-start justify-start text-sm cursor-pointer hover:bg-accent" , templ.Attributes{
                                                        //                 "hx-post": "/tasks?id="+task.ID,
                                                        //                 "hx-target": "#content",
                                                        //                 "hx-swap": "innerHtml",
                                                        //                 "hx-push-url": "true",
                                                        //                 "hx-indicator": ".htmx-loader,.loaded-content",
                                                        //             }) {
                                                        //                 <i data-lucide="clipboard-check" class="w-4 h-4"></i>
                                                        //                 Task Details
                                                        //             }
                                                        //             @ui.DropdownItem(false, false, "h-10 flex items-start justify-start text-sm cursor-pointer hover:bg-accent" , templ.Attributes{
                                                        //                 "hx-post": "/tasks?id="+task.ID+"#edit-task-form",
                                                        //                 "hx-target": "#content",
                                                        //                 "hx-swap": "innerHtml",
                                                        //                 "hx-push-url": "true",
                                                        //                 "hx-indicator": ".htmx-loader,.loaded-content",
                                                        //             }) {
                                                        //                 <i data-lucide="edit" class="w-4 h-4"></i>
                                                        //                 Edit Task
                                                        //             }
                                                        //             @ui.DropdownItem(false, false, "h-10 flex items-start justify-start text-amber-700 text-sm cursor-pointer dark:hover:bg-gray-400 hover:bg-red-100" , templ.Attributes{
                                                        //                 "hx-post": "/delete-task?id="+task.ID+"#edit-task-form",
                                                        //                 "hx-target": "#toaster",
                                                        //                 "hx-swap": "innerHtml",
                                                        //             }) {
                                                        //                 <i data-lucide="edit" class="w-4 h-4"></i>
                                                        //                 Delete Task
                                                        //             }
                                                        //         }
                                                        //     }
                                                        // }
                                                    }
                                                }
                                            }
                                        }
                                    </div>
                                </div>
                            }
                        }
                        @ui.TabsContent("kanban", "overflow-auto scrollbar-thin mt-0", nil) {
                            
                        }
                        @ui.TabsContent("calendar", "overflow-auto scrollbar-thin mt-0 h-full pb-4", nil) {
                            
                        }
                    </div>
                </div>
            }
        </div>
    </div>
}

templ Projects(projects []models.Project) {
    for _,p := range projects {
        <span>{p.Title}</span>
    }
}

templ CreateProject(workspaceID string, class string, attrs templ.Attributes) {
    @components.ResponsiveModal("create-project-modal", "Create Project", class) {
        <div id="create-project-form" 
            x-init={fmt.Sprintf("workspace_id= '%s';",workspaceID)}
            x-data="{
                        workspace_id: '',
                        init() {
                            document.body.addEventListener('modal:opened', (evt) => {
                                if (evt.detail.id === 'create-project-modal') {
                                    htmx.ajax('GET', '/create-project-form?workspace_id='+this.workspace_id, {target: '#create-project-form', swap: 'innerHtml'})
                                }
                            });
                            document.body.addEventListener('modal:closed', (evt) => {
                                if (evt.detail.id === 'create-project-modal') {
                                    document.getElementById('create-project-form').innerHTML = '';
                                }
                            });
                        }
                    }"
        >
            
        </div>
    }
}

templ CreateProjectForm(workspaceID string) {
    <div
        x-data="{
                    today: new Date(),
                    workspace_id: '',
                    title: '',
                    description: '',
                    status: '',
                    titleError: '',
                    descriptionError: '',
                    statusError: '',
                    validateTitle() {
                        this.titleError = (this.title.trim() === '')
                            ? 'Title is required'
                            : '';
                        this.title = this.title.charAt(0).toUpperCase() + this.title.slice(1);
                    },
                    validateStatus() {
                        this.statusError = (this.status.trim() === '')
                            ? 'Status is required'
                            : '';
                    },
                    validateForm(e) {
                        e.preventDefault();
                        this.validateTitle();
                        this.validateStatus();
                        
                        if (this.titleError || this.statusError) {
                            return; 
                        }
                    },
                    init() {
                        document.body.addEventListener('htmx:afterRequest', (evt) => {
                            if (evt.detail.successful && evt.detail.elt.id === 'create-project-form') {
                                $store.modal.close('create-project-modal');
                                this.title = '';
                                this.description = '';
                                this.status = '';
                                this.titleError = '';
                                this.descriptionError = '';
                                this.statusError = '';
                                const params = new URLSearchParams(window.location.search);
                                if ('/workspaces?id='+params.get('id') === '/workspaces?id='+this.workspace_id) {
                                    htmx.ajax('POST', '/workspaces?id='+params.get('id'), { 
                                        target: '#content', 
                                        swap: 'innerHTML' 
                                    })
                                }
                            }
                        })
                    }
                }"
        x-init={fmt.Sprintf("workspace_id= '%s'; status= 'PLANNING';", workspaceID)}
    >
        @ui.Form("/project", "post", "w-lg", templ.Attributes{
                "id":"create-project-form",
                "hx-target": "#toaster",
                "hx-swap": "innerHtml",
                "hx-disabled-elt":"#create-button,#title,#description",
                "x-ref": "form",
                "@submit.prevent":"validateForm($event)",
        }) {
            <input id="workspace_id" x-show="false" type="hidden" name="workspace_id" x-model="workspace_id" :value="workspace_id" />
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                <div class="w-full space-y-4">
                    @ui.FormItem("mb-4", nil) {
                        @ui.FormLabel("title", "Title", "", nil)
                        @ui.FormControl("title", "title", "text", "Project Title", "", "", templ.Attributes{
                            "autocomplete":"title",
                            "x-model": "title",
                            "@blur": "validateTitle",
                        })
                        @ui.FormMessage("", "", templ.Attributes{
                                "x-show": "titleError != ''",
                                "x-text": "titleError",
                            },
                        )
                    }
                    @ui.FormItem("mb-4", nil) {
                        @ui.FormLabel("description", "Description", "", nil)
                        @ui.FormControl("description", "description", "textarea", "Project Description", "", "", templ.Attributes{
                            "autocomplete":"description",
                            "x-model": "description",
                            "@blur": "description=description.charAt(0).toUpperCase() + description.slice(1)",
                        })
                        @ui.FormMessage("", "", templ.Attributes{
                                "x-show": "descriptionError != ''",
                                "x-text": "descriptionError",
                            },
                        )
                    }
                    <div class="grid grid-cols-1 sm:grid-cols-2">
                        <div class="w-full">
                            @ui.FormItem("mb-4", nil) {
                                @ui.FormLabel("start_date", "Start Date", "", nil)
                                @ui.FormControl("start_date", "start_date", "date", "", utils.FormatDate(time.Now()), "w-46", templ.Attributes{})
                                @ui.FormMessage("", "", templ.Attributes{},
                                )
                            }
                        </div>
                        <div class="w-full">
                            @ui.FormItem("mb-4", nil) {
                                @ui.FormLabel("due_date", "Due Date", "", nil)
                                @ui.FormControl("due_date", "due_date", "date", "", utils.FormatDate(time.Now()), "w-46", templ.Attributes{})
                                @ui.FormMessage("", "", templ.Attributes{},
                                )
                            }
                        </div>
                    </div>
                </div>
                <div class="w-full space-y-4">
                    @ui.FormItem("mb-4", nil) {
                        @ui.FormLabel("members", "Members", "", nil)
                        @components.MemberRoleInput("members",
                            "members",
                            "Type a member...",
                            []models.UserRole{},  
                            services.GetWorkspaceMembers(workspaceID),
                            "",
                            nil,
                        )
                        @ui.FormMessage("", "", templ.Attributes{},
                        )
                    }
                    @ui.FormItem("mb-4", nil) {
                        @ui.FormLabel("tags", "Tags", "", nil)
                        @components.TagInput("project-tag", "tags", "Add tag...", []string{}, "", nil)
                        @ui.FormMessage("", "", templ.Attributes{},
                        )
                    }
                </div>
            </div>
            @components.DottedSeparator("", "#d4d4d8", "2px", "", "", "horizontal")
            <div class="flex justify-end items-end">
                @ui.Button("create-button", "", "", "", "Create", "", templ.Attributes{"type": "submit"}) 
            </div>
        }
    </div>
}

templ EditProject(projectID string, class string, attrs templ.Attributes) {
    @components.ResponsiveModal("edit-project-modal", "Edit Project", class) {
        <div id="edit-project-form" 
            x-init={fmt.Sprintf("project_id= '%s';",projectID)}
            x-data="{
                        project_id: '',
                        init() {
                            document.body.addEventListener('modal:opened', (evt) => {
                                if (evt.detail.id === 'edit-project-modal') {
                                    htmx.ajax('GET', '/edit-project-form?project_id='+this.project_id, {target: '#edit-project-form', swap: 'innerHtml'})
                                }
                            });
                            document.body.addEventListener('modal:closed', (evt) => {
                                if (evt.detail.id === 'edit-project-modal') {
                                    document.getElementById('edit-project-form').innerHTML = '';
                                }
                            });
                        }
                    }"
        >
            
        </div>
    }
}

templ EditProjectForm(project models.Project) {
    <div
        x-data="{
                    project: {},
                    today: new Date(),
                    titleError: '',
                    descriptionError: '',
                    statusError: '',
                    validateTitle() {
                        this.titleError = (this.project.title.trim() === '')
                            ? 'Title is required'
                            : '';
                        this.project.title = this.project.title.charAt(0).toUpperCase() + this.project.title.slice(1);
                    },
                    validateStatus() {
                        this.statusError = (this.project.status.trim() === '')
                            ? 'Status is required'
                            : '';
                    },
                    validateForm(e) {
                        e.preventDefault();
                        this.validateTitle();
                        this.validateStatus();
                        
                        if (this.titleError || this.statusError) {
                            return; 
                        }
                    },
                    init() {
                        document.body.addEventListener('htmx:afterRequest', (evt) => {
                            if (evt.detail.successful && evt.detail.elt.id === 'edit-project-form') {
                                $store.modal.close('edit-project-modal');
                                this.title = '';
                                this.description = '';
                                this.status = '';
                                this.titleError = '';
                                this.descriptionError = '';
                                this.statusError = '';
                                const params = new URLSearchParams(window.location.search);
                                if ('/projects?id='+params.get('id') === '/projects?id='+this.project.id.trim()) {
                                    htmx.ajax('POST', '/projects?id='+this.project.id, { 
                                        target: '#content', 
                                        swap: 'innerHTML' 
                                    })
                                }
                            }
                        })
                    }
                }"
        x-init={fmt.Sprintf("project= %s", string(utils.MustJSON(project)))}
    >
        @ui.Form("/project", "put", "w-lg", templ.Attributes{
                "id":"edit-project-form",
                "hx-target": "#toaster",
                "hx-swap": "innerHtml",
                "hx-disabled-elt":"#save-button,#title,#description",
                "x-ref": "form",
                "@submit.prevent":"validateForm($event)",
        }) {
            <input id="workspace_id" x-show="false" type="hidden" name="workspace_id" x-model="project.workspace_id" />
            <input id="project_id" x-show="false" type="hidden" name="project_id" x-model="project.id" :value="project.id" />
            <input id="status" x-show="false" type="hidden" name="status" x-model="project.status" :value="project.status" />
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                <div class="w-full space-y-4">
                    @ui.FormItem("mb-4", nil) {
                        @ui.FormLabel("title", "Title", "", nil)
                        @ui.FormControl("title", "title", "text", "Project Title", "", "", templ.Attributes{
                            "autocomplete":"title",
                            "x-model": "project.title",
                            "@blur": "validateTitle",
                        })
                        @ui.FormMessage("", "", templ.Attributes{
                                "x-show": "titleError != ''",
                                "x-text": "titleError",
                            },
                        )
                    }
                    @ui.FormItem("mb-4", nil) {
                        @ui.FormLabel("description", "Description", "", nil)
                        @ui.FormControl("description", "description", "textarea", "Project Description", "", "", templ.Attributes{
                            "autocomplete":"description",
                            "x-model": "project.description",
                            "@blur": "project.description=project.description.charAt(0).toUpperCase() + project.description.slice(1)",
                        })
                        @ui.FormMessage("", "", templ.Attributes{
                                "x-show": "descriptionError != ''",
                                "x-text": "descriptionError",
                            },
                        )
                    }
                    <div class="grid grid-cols-1 sm:grid-cols-2">
                        <div class="w-full">
                            @ui.FormItem("mb-4", nil) {
                                @ui.FormLabel("start_date", "Start Date", "", nil)
                                @ui.FormControl("start_date", "start_date", "date", "", utils.FormatDate(*project.StartDate), "w-46", templ.Attributes{})
                                @ui.FormMessage("", "", templ.Attributes{},
                                )
                            }
                        </div>
                        <div class="w-full">
                            @ui.FormItem("mb-4", nil) {
                                @ui.FormLabel("due_date", "Due Date", "", nil)
                                @ui.FormControl("due_date", "due_date", "date", "", utils.FormatDate(*project.DueDate), "w-46", templ.Attributes{})
                                @ui.FormMessage("", "", templ.Attributes{},
                                )
                            }
                        </div>
                    </div>
                </div>
                <div class="w-full space-y-4">
                    @ui.FormItem("mb-4", nil) {
                        @ui.FormLabel("members", "Members", "", nil)
                        
                        @components.MemberRoleInput("members",
                            "members",
                            "Add a member...",
                            utils.ExtractUserMemberOfProject(project),
                            services.GetWorkspaceMembers(project.WorkspaceID),
                            "",
                            nil,
                        )
                        @ui.FormMessage("", "", templ.Attributes{},
                        )
                    }
                    @ui.FormItem("mb-4", nil) {
                        @ui.FormLabel("tags", "Tags", "", nil)
                        @components.TagInput("project-tag", "tags", "Add tag...", utils.ExtractTagsFromProject(project), "", nil)
                        @ui.FormMessage("", "", templ.Attributes{},
                        )
                    }
                </div>
            </div>
            @components.DottedSeparator("", "#d4d4d8", "2px", "", "", "horizontal")
            <div class="flex justify-end items-end">
                @ui.Button("save-button", "", "", "", "Update Project", "", templ.Attributes{"type": "submit"}) 
            </div>
        }
    </div>
}