package features

import "etop/templates/components/ui"
import "etop/templates/components"

templ WorkspaceSwitcher(list []ui.SelectOption) {
    @ui.Select("Workspace", "", list, "w-full h-12", nil) {
        <li 
            @click="$store.modal.open('demoModal')"
            class="flex items-center space-x-2 px-3 py-2 cursor-pointer" 
        >
                <div data-lucide="circle-plus" />
            <span>Create Workspace</span>
        </li>        
    }
    
}

templ CreateWorkspace(class string, attrs templ.Attributes) {
    @components.ResponsiveModal("workspace-modal", "Create Workspace", class) {
        <div
            x-data="{
                        name: '',
                        description: '',
                        nameError: '',
                        descriptionError : '',
                        colorError: '',
                        validateName() {
                            this.nameError = (this.name.length < 0)
                                ? 'Name is required'
                                : '';
                        },
                        validateForm(e) {
                            e.preventDefault();
                            this.validateName();
                            
                            if (this.nameError) {
                                return; 
                            }
                        },
                        init() {
                            document.body.addEventListener('htmx:afterRequest', (evt) => {
                                if (evt.detail.successful && evt.detail.elt.id === 'create-workspace-form') {
                                    
                                }
                            })
                        }
                    }"
        >
            @ui.Form("/create-workspace", "post", "", templ.Attributes{
                    "id":"create-workspace-form",
                    "hx-target": "#toaster",
                    "hx-swap": "innerHtml",
                    "hx-disabled-elt":"#create-button,#name,#description",
                    "x-ref": "form",
                    "@submit.prevent":"validateForm($event)",
            }) {
                @ui.FormItem("", nil) {
                    @ui.FormLabel("name", "Name", "", nil)
                    @ui.FormControl("name", "name", "text", "Workspace Name", "", "", templ.Attributes{
                        "id": "name",
                        "name": "Name",
                        "autocomplete":"name",
                        "x-model": "name",
                        "@blur": "validateName",
                    })
                    @ui.FormMessage("", "", templ.Attributes{
                            "x-show": "nameError != ''",
                            "x-text": "nameError",
                        },
                    )
                }
                @ui.FormItem("", nil) {
                    @ui.FormLabel("description", "Description", "", nil)
                    @ui.FormControl("description", "description", "textarea", "Workspace Description", "asd", "", templ.Attributes{
                        "id": "description",
                        "name": "description",
                        "autocomplete":"description",
                        "x-model": "description",
                    })
                    @ui.FormMessage("", "", templ.Attributes{
                            "x-show": "descriptionError != ''",
                            "x-text": "descriptionError",
                        },
                    )
                }
                @ui.FormItem("", nil) {
                    @ui.FormLabel("color", "Color", "", nil)
                    <div 
                        x-data="{ 
                            colors: [
                                { name: 'blue',  class: 'bg-blue-500 dark:bg-blue-400' },
                                { name: 'red',   class: 'bg-red-500 dark:bg-red-400' },
                                { name: 'yellow',class: 'bg-yellow-500 dark:bg-yellow-400' },
                                { name: 'green', class: 'bg-green-500 dark:bg-green-400' },
                                { name: 'purple',class: 'bg-purple-500 dark:bg-purple-400' },
                                { name: 'orange',class: 'bg-orange-500 dark:bg-orange-400' },
                                { name: 'teal',  class: 'bg-teal-500 dark:bg-teal-400' }
                            ], 
                            selectedColor: null 
                        }"
                        class="flex items-center space-x-3 mt-2"
                    >
                        <template x-for="color in colors" :key="color.name">
                            <button 
                                type="button"
                                class="h-8 w-8 rounded-full border-2 transition"
                                :class="[
                                    color.class, 
                                    selectedColor === color.name ? 'border-black dark:border-white scale-110' : 'border-transparent'
                                ]"
                                @click="selectedColor = color.name"
                                :title="color.name"
                            ></button>
                        </template>

                        <!-- Hidden input buat form -->
                        <input type="hidden" name="color" :value="selectedColor">
                    </div>

                    // @ui.FormControl("color", "color", "radio", "Workspace Color", "", "", templ.Attributes{
                    //     "id": "color",
                    //     "name": "color",
                    //     "x-model": "color",
                    // })
                    @ui.FormMessage("", "", templ.Attributes{
                            "x-show": "colorError != ''",
                            "x-text": "colorError",
                        },
                    )
                }
            }
        </div>
    }
}