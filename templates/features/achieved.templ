package features

import (
    "fmt"
    "strconv"

    "etop/dto"
    "etop/models"
    "etop/templates/components"
    "etop/templates/components/ui"
)

templ Achieved(tasks []models.Task, user dto.UserAuth, page models.PageInfo, years []int, selectedYear string) {
    <div class="mx-auto space-y-6">
        <div class="flex items-center justify-between">
            <h1 class="text-2xl font-bold">Achieved</h1>
            <span class="text-sm text-muted-foreground">{fmt.Sprintf("%d task(s) completed", page.Total)}</span>
        </div>

        @components.DottedSeparator("", "#d4d4d8", "2px", "", "", "horizontal")

        if len(years) > 0 {
            <div class="flex items-center gap-2 flex-wrap">
                <span class="text-sm font-medium text-muted-foreground">Year:</span>
                <button type="button"
                    class={fmt.Sprintf("px-3 py-1 text-sm rounded-md border transition %s", tern(selectedYear == "", "bg-primary text-primary-foreground border-primary", "bg-background hover:bg-accent border-border"))}
                    hx-post="/achieve?page=1"
                    hx-target="#content"
                    hx-swap="innerHTML"
                    hx-push-url="true"
                >All</button>
                for _, y := range years {
                    <button type="button"
                        class={fmt.Sprintf("px-3 py-1 text-sm rounded-md border transition %s", tern(selectedYear == strconv.Itoa(y), "bg-primary text-primary-foreground border-primary", "bg-background hover:bg-accent border-border"))}
                        hx-post={fmt.Sprintf("/achieve?page=1&year=%d", y)}
                        hx-target="#content"
                        hx-swap="innerHTML"
                        hx-push-url="true"
                    >{strconv.Itoa(y)}</button>
                }
            </div>
        }

        if len(tasks) > 0 {
            <div class="space-y-0 border rounded-lg overflow-hidden">
                <div class="grid grid-cols-12 gap-2 px-4 py-2 bg-muted/50 text-xs font-medium text-muted-foreground">
                    <div class="col-span-5">
                        @ui.Button("sort-title", "ghost", "xs", "arrow-up-down", "Task", "", templ.Attributes{
                            "type": "button",
                            "hx-post": fmt.Sprintf("/achieve?page=1&sort_by=title&sort_dir=%s", toggleSortDir("title", page)),
                            "hx-target": "#content",
                            "hx-swap": "innerHTML",
                            "hx-push-url": "true",
                        })
                    </div>
                    <div class="col-span-2">
                        @ui.Button("sort-type", "ghost", "xs", "arrow-up-down", "Type", "", templ.Attributes{
                            "type": "button",
                            "hx-post": fmt.Sprintf("/achieve?page=1&sort_by=type&sort_dir=%s", toggleSortDir("type", page)),
                            "hx-target": "#content",
                            "hx-swap": "innerHTML",
                            "hx-push-url": "true",
                        })
                    </div>
                    <div class="col-span-2">
                        @ui.Button("sort-status", "ghost", "xs", "arrow-up-down", "Status", "", templ.Attributes{
                            "type": "button",
                            "hx-post": fmt.Sprintf("/achieve?page=1&sort_by=status&sort_dir=%s", toggleSortDir("status", page)),
                            "hx-target": "#content",
                            "hx-swap": "innerHTML",
                            "hx-push-url": "true",
                        })
                    </div>
                    <div class="col-span-1">
                        @ui.Button("sort-priority", "ghost", "xs", "arrow-up-down", "Priority", "", templ.Attributes{
                            "type": "button",
                            "hx-post": fmt.Sprintf("/achieve?page=1&sort_by=priority&sort_dir=%s", toggleSortDir("priority", page)),
                            "hx-target": "#content",
                            "hx-swap": "innerHTML",
                            "hx-push-url": "true",
                        })
                    </div>
                    <div class="col-span-2">
                        @ui.Button("sort-assignee", "ghost", "xs", "arrow-up-down", "Assignee", "", templ.Attributes{
                            "type": "button",
                            "hx-post": fmt.Sprintf("/achieve?page=1&sort_by=assignee&sort_dir=%s", toggleSortDir("assignee", page)),
                            "hx-target": "#content",
                            "hx-swap": "innerHTML",
                            "hx-push-url": "true",
                        })
                    </div>
                </div>
                for _, task := range tasks {
                    <div class="grid grid-cols-12 gap-2 px-4 py-3 border-t border-border items-center hover:bg-muted/30 cursor-pointer transition"
                        hx-post={fmt.Sprintf("/tasks?id=%s", task.ID)}
                        hx-target="#content"
                        hx-swap="innerHTML"
                        hx-push-url="true"
                        hx-indicator=".htmx-loader,.loaded-content"
                    >
                        <div class="col-span-5">
                            <div class="text-sm font-medium truncate">{task.Title}</div>
                            if task.CompletedAt != nil {
                                <div class="text-xs text-muted-foreground">
                                    Completed {task.CompletedAt.Format("Jan 2, 2006")}
                                </div>
                            }
                        </div>
                        <div class="col-span-2">
                            <span class="inline-flex items-center rounded-md border px-2.5 py-0.5 text-xs font-semibold transition-colors border-transparent bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200">
                                {task.Type}
                            </span>
                        </div>
                        <div class="col-span-2">
                            <span class="inline-flex items-center rounded-md border px-2.5 py-0.5 text-xs font-semibold transition-colors border-transparent bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200">
                                {task.Status.Label}
                            </span>
                        </div>
                        <div class="col-span-1">
                            <div class="flex items-center gap-0.5">
                                for i := 1; i <= 3; i++ {
                                    if i <= task.Priority.Level {
                                        <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-yellow-400 fill-yellow-400" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l2.037 6.272h6.594c.969 0 1.371 1.24.588 1.81l-5.335 3.876 2.037 6.272c.3.921-.755 1.688-1.54 1.118L12 18.347l-5.332 3.928c-.784.57-1.838-.197-1.539-1.118l2.037-6.272-5.335-3.876c-.783-.57-.38-1.81.588-1.81h6.594z"/>
                                        </svg>
                                    } else {
                                        <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-gray-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l2.037 6.272h6.594c.969 0 1.371 1.24.588 1.81l-5.335 3.876 2.037 6.272c.3.921-.755 1.688-1.54 1.118L12 18.347l-5.332 3.928c-.784.57-1.838-.197-1.539-1.118l2.037-6.272-5.335-3.876c-.783-.57-.38-1.81.588-1.81h6.594z"/>
                                        </svg>
                                    }
                                }
                            </div>
                        </div>
                        <div class="col-span-2 flex items-center gap-2">
                            @ui.Avatar(task.Assignee.FullName, task.Assignee.Color, "xs", "h-6 w-6", nil)
                            <span class="text-xs truncate">{task.Assignee.FullName}</span>
                        </div>
                    </div>
                }
            </div>
            @ui.Pagination("/achieve", page, "")
        } else {
            <div class="text-center py-12 text-muted-foreground">
                <p class="text-lg">No achieved tasks yet</p>
                <p class="text-sm mt-1">Completed tasks will appear here</p>
            </div>
        }
    </div>
}
