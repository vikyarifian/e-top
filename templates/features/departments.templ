package features

import (
    "fmt"
    "strings"
    "strconv"
    
	"etop/models"
	"etop/dto"
    "etop/templates/components"
    "etop/templates/components/ui"
    "etop/templates/pages"
)

templ Departments(depts []models.Department, user dto.UserAuth) {
    if user.Level != "ADMIN" {
        @pages.Forbidden()
    } else {
        
        <div data-title="Departments" class="space-y-6">
            <div class="flex items-center justify-between ">
                <div>
                    <h2 class="text-3xl font-bold tracking-tight">Departments</h2>
                    <p class="text-muted-foreground p-1">View all of departments here</p>
                </div>
                <div>
                    @ui.Button("create-department", "", "sm", "", "", "", templ.Attributes{
                        "type": "button",
                        "@click":"$store.modal.open('create-department-modal')",
                    }) {
                        <i data-lucide="circle-plus" class="w-4 h-4 "></i><span x-text="`${isMobile ? 'New' : 'New Department'}`"></span>
                    }
                </div>
            </div>

            <!-- Stats Cards -->
            <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
                if len(depts) == 0 {
                    @components.NoData("No departments found", "Create a department to get started", nil) {
                        @ui.Button("create-department", "outline", "xs", "circle-plus", "Create Department", "", templ.Attributes{
                            "type": "button",
                            "@click":"$store.modal.open('create-department-modal')",
                        })
                    }
                }
                for _, dept := range depts {
                    <div
                        hx-post={"/departments?id="+dept.ID}
                        hx-target="#content"
                        hx-swap="innerHTML"
                        hx-push-url="true"
                        hx-indicator=".htmx-loader,.loaded-content" 
                        class="rounded-lg border border-border bg-card text-card-foreground shadow-sm p-4 transition-all duration-300 hover:shadow-md hover:-translate-y-1 cursor-pointer"
                    >
                        <div class="flex items-center justify-between space-y-0 pb-2">
                            <div class="flex gap-2">
                                <div class="p-1">
                                    <div class={"w-7 h-7 p-2 rounded-md text-white flex items-center justify-center text-xs font-semibold " , dept.Color}>
                                        {strings.ToUpper(dept.Name[0:1])}
                                    </div>
                                </div>
                                <div>
                                    <div>
                                        <h3 class="tracking-tight font-semibold">{dept.Name}</h3>
                                        <div class="text-xs text-muted-foreground">Created at {dept.CreatedAt.Format("Mon, 02 Jan 2006")}</div>
                                    </div>
                                </div>
                            </div>
                            <div class="flex flex-row justify-between items-center">
                                <svg data-lucide="users" class="w-4 h-4 mr-1 text-muted-foreground" /> 
                                <span class="text-xs text-muted-foreground">{strconv.Itoa(len(dept.Members))}</span>
                            </div>
                        </div>
                        <div class="min-h-[50px] p-1">
                            // <div class="text-2xl font-bold">+2350</div>
                            <p class="text-md">{dept.Description}</p>
                        </div>
                        <div class="pt-4 pb-4">
                            @components.DottedSeparator("", "#d4d4d8", "1px", "", "", "horizontal")
                        </div>
                        <div class="text-sm text-muted-foreground">view department details</div>
                    </div>
                }
            </div>
            
        </div>
    }
}

templ Department(dept models.Department, user dto.UserAuth, tugas dto.DeptTasks) {
    <div data-title={dept.Name} class="space-y-6">
        <div class="flex items-center justify-between">
            <div>
                <div class="flex items-center justify-left space-y-0">
                    <div class="p-1 mr-2">
                        <div class={"w-7 h-7 p-2 rounded-md text-white flex items-center justify-center text-sm font-semibold " , dept.Color}>
                            {strings.ToUpper(dept.Name[0:1])}
                        </div>
                    </div>
                    <h2 class="text-3xl font-bold tracking-tight">{dept.Name}</h2>
                </div>
                <p class="text-muted-foreground p-1">{dept.Description}</p>
            </div>
            <div>
                if user.Level == "ADMIN" {
                    @InviteDepartment(dept.ID, dept.Name, dept.Color, "w-96", nil)
                    @ui.Button("invite-dept", "outline", "sm", "", "", "mr-1", templ.Attributes{
                        "type": "button",
                        "@click":"$store.modal.open('invite-department-modal')",
                    }) {
                        <i data-lucide="user-plus" class="w-4 h-4 "></i><span x-show="!isMobile" x-text="`${isMobile ? '' : 'Invite'}`"></span>
                    }
                    @ui.Button("dept-settings", "outline", "sm", "", "", "", templ.Attributes{
                        "type": "button",
                        "@click.stop": "window.dept_id='"+dept.ID+"'; $store.modal.open('edit-department-modal')",
                    }) {
                        <i data-lucide="settings" class="w-4 h-4 "></i>
                    }
                } else {
                    for _, m := range dept.Members {
                        if m.UserID == user.ID && m.Role == "MANAGER" {
                            @InviteDepartment(dept.ID, dept.Name, dept.Color, "w-96", nil)
                            @ui.Button("invite-dept", "outline", "sm", "", "", "mr-1", templ.Attributes{
                                "type": "button",
                                "@click":"$store.modal.open('invite-department-modal')",
                            }) {
                                <i data-lucide="user-plus" class="w-4 h-4 "></i><span x-show="!isMobile" x-text="`${isMobile ? '' : 'Invite'}`"></span>
                            }
                            @ui.Button("dept-settings", "outline", "sm", "", "", "", templ.Attributes{
                                "type": "button",
                                "@click.stop": "window.dept_id='"+dept.ID+"'; $store.modal.open('edit-department-modal')",
                            }) {
                                <i data-lucide="settings" class="w-4 h-4 "></i>
                            }
                        }
                    }
                }
            </div>
        </div>
        @EditDept("w-96")
        @components.DottedSeparator("", "#d4d4d8", "1px", "", "", "horizontal")
        <div class="flex items-center gap-2">
            <span class="text-sm text-muted-foreground mr-2">Manager : </span>
            <div class="flex items-center gap-2">
                @ui.Avatar(dept.DeptHead.FullName, dept.DeptHead.Color, "sm", "h-8 w-8 border-2 border-background", nil)
                <span class="text-sm font-medium">{dept.DeptHead.FullName}</span>
            </div>
        </div>
        @components.DottedSeparator("", "#d4d4d8", "1px", "", "", "horizontal")
        <div class="flex items-center gap-2">
            <span class="text-sm text-muted-foreground mr-2">Members : </span>
            <div class="flex">
                for _,member := range dept.Members {
                    @ui.Tooltip(strings.Split(member.User.FullName," ")[0]+" ("+strings.Trim(member.Role, " ")+")", "w-[180px]", nil) {
                        @ui.Avatar(member.User.FullName, member.User.Color, "sm", "h-8 w-8 border-2 border-background overflow-hidden cursor-pointer -space-x-2 -ml-2", nil) 
                    }
                }
            </div>
        </div>

        @components.DottedSeparator("", "#d4d4d8", "2px", "", "", "horizontal")

        <div x-data={ deptTasksScope(dept.ID, tugas) }>
            <div class="flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between">
                <div>
                    <h3 class="text-lg font-medium">Tugas Anggota</h3>
                    <p class="text-sm text-muted-foreground">
                        Seluruh tugas milik anggota departemen ini
                    </p>
                </div>
                <div class="flex flex-wrap items-center gap-3">
                    @ui.SearchBox("search-dept-tasks", "Cari judul atau keterangan")
                    @ui.FilterSelect("filter-dept-member", "Anggota", "member", memberOptions(tugas))
                    @ui.FilterSelect("filter-dept-status", "Status", "status", statusOptions())
                    @ui.FilterSelect("filter-dept-priority", "Priority", "priority", priorityOptions())
                    <button type="button"
                        x-show="menyaring()"
                        x-cloak
                        @click="bersihkan()"
                        class="inline-flex items-center gap-1 h-9 px-2.5 rounded-md border border-input text-xs text-muted-foreground hover:text-foreground hover:bg-muted transition"
                    >
                        <svg data-lucide="filter-x" class="h-3.5 w-3.5"></svg>
                        Bersihkan
                    </button>
                </div>
            </div>

            <div id="dept-task-list" class="mt-4">
                @DepartmentTaskList(tugas)
            </div>
        </div>
    </div>
}

// DepartmentTaskList adalah pecahan berisi daftar tugas anggota departemen
// beserta penomoran halamannya. Hanya bagian ini yang ditukar ketika pengguna
// mencari, menyaring, atau berpindah halaman, sehingga sisa halaman departemen
// tidak ikut dirender ulang.
templ DepartmentTaskList(tugas dto.DeptTasks) {
    if tugas.Page.Menyaring() {
        <p class="text-xs text-muted-foreground mb-2">
            { fmt.Sprintf("%d tugas cocok dengan penyaring yang sedang berlaku.", tugas.Page.Total) }
        </p>
    }
    if len(tugas.Tasks) > 0 {
        <div class="space-y-0 border rounded-lg overflow-hidden">
            <div class="grid grid-cols-12 gap-2 px-4 py-2 bg-muted/50 text-xs font-medium text-muted-foreground">
                <div class="col-span-4">Tugas</div>
                <div class="col-span-3">Anggota</div>
                <div class="col-span-2">Status</div>
                <div class="col-span-1">Prioritas</div>
                <div class="col-span-2">Tenggat</div>
            </div>
            for _, task := range tugas.Tasks {
                <div class="grid grid-cols-12 gap-2 px-4 py-3 border-t border-border items-center hover:bg-muted/30 cursor-pointer transition"
                    hx-post={ fmt.Sprintf("/tasks?id=%s", task.ID) }
                    hx-target="#content"
                    hx-swap="innerHTML"
                    hx-push-url="true"
                    hx-indicator=".htmx-loader,.loaded-content"
                >
                    <div class="col-span-4">
                        <div class="text-sm font-medium truncate">{ task.Title }</div>
                        <div class="text-xs text-muted-foreground">{ task.Type }</div>
                    </div>
                    <div class="col-span-3 flex items-center gap-2">
                        @ui.Avatar(task.Assignee.FullName, task.Assignee.Color, "xs", "h-6 w-6", nil)
                        <span class="text-xs truncate">{ task.Assignee.FullName }</span>
                    </div>
                    <div class="col-span-2">
                        <span class="inline-flex items-center rounded-md border px-2.5 py-0.5 text-xs font-semibold transition-colors border-transparent bg-muted">
                            { task.Status.Label }
                        </span>
                    </div>
                    <div class="col-span-1">
                        <div class="flex items-center gap-0.5">
                            for i := 1; i <= 3; i++ {
                                if i <= task.Priority.Level {
                                    <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-yellow-400 fill-yellow-400" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l2.037 6.272h6.594c.969 0 1.371 1.24.588 1.81l-5.335 3.876 2.037 6.272c.3.921-.755 1.688-1.54 1.118L12 18.347l-5.332 3.928c-.784.57-1.838-.197-1.539-1.118l2.037-6.272-5.335-3.876c-.783-.57-.38-1.81.588-1.81h6.594z"/>
                                    </svg>
                                } else {
                                    <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-gray-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l2.037 6.272h6.594c.969 0 1.371 1.24.588 1.81l-5.335 3.876 2.037 6.272c.3.921-.755 1.688-1.54 1.118L12 18.347l-5.332 3.928c-.784.57-1.838-.197-1.539-1.118l2.037-6.272-5.335-3.876c-.783-.57-.38-1.81.588-1.81h6.594z"/>
                                    </svg>
                                }
                            }
                        </div>
                    </div>
                    <div class="col-span-2 text-xs text-muted-foreground">
                        if task.DueDate != nil {
                            { task.DueDate.Format("2 Jan 2006") }
                        } else {
                            { "-" }
                        }
                    </div>
                </div>
            }
        </div>
        @ui.PaginationTarget("/department", tugas.Page, deptTaskParams(tugas.DeptID, tugas), "dept-task-list")
    } else if tugas.Page.Menyaring() {
        <div class="text-center py-10 text-muted-foreground">
            <p class="text-sm">Tidak ada tugas yang cocok</p>
            <p class="text-xs mt-1">Ubah kata kunci atau penyaringnya, atau tekan Bersihkan.</p>
        </div>
    } else {
        <div class="text-center py-10 text-muted-foreground">
            <p class="text-sm">Belum ada tugas pada departemen ini</p>
        </div>
    }
}


templ DepartmentJoin(dept models.Department, user dto.UserAuth) {
    <div data-title={dept.Name} class="space-y-6">
        <div class="flex items-center justify-between">
            <div>
                <div class="flex items-center justify-left space-y-0">
                    <div class="p-1 mr-2">
                        <div class={"w-7 h-7 p-2 rounded-md text-white flex items-center justify-center text-sm font-semibold " , dept.Color}>
                            {strings.ToUpper(dept.Name[0:1])}
                        </div>
                    </div>
                    <h2 class="text-3xl font-bold tracking-tight">{dept.Name}</h2>
                </div>
                <p class="text-muted-foreground p-1">{dept.Description}</p>
            </div>
        </div>
        <div class="flex items-center gap-2">
            <span class="text-sm text-muted-foreground mr-2">Manager : </span>
            <div class="flex items-center gap-2">
                @ui.Avatar(dept.DeptHead.FullName, dept.DeptHead.Color, "sm", "h-8 w-8 border-2 border-background", nil)
                <span class="text-sm font-medium">{dept.DeptHead.FullName}</span>
            </div>
        </div>
        @components.DottedSeparator("", "#d4d4d8", "1px", "", "", "horizontal")
        <div class="flex items-center gap-2">
            <span class="text-sm text-muted-foreground mr-2">Members : </span>
            <div class="flex">
                for _,member := range dept.Members {
                    @ui.Tooltip(strings.Split(member.User.FullName," ")[0]+" ("+strings.Trim(member.Role, " ")+")", "w-[180px]", nil) {
                        @ui.Avatar(member.User.FullName, member.User.Color, "sm", "h-8 w-8 border-2 border-background overflow-hidden cursor-pointer -space-x-2 -ml-2", nil) 
                    }
                }
            </div>
        </div>
        @components.DottedSeparator("", "#d4d4d8", "1px", "", "", "horizontal")
        <div class="flex justify-center">
            @ui.Button("join-dept-"+dept.ID, "", "lg", "user-plus", "Request to Join", "", templ.Attributes{
                "type": "button",
                "hx-post": "/join-department?id="+dept.ID,
                "hx-target": "#toaster",
                "hx-swap": "innerHtml",
                "hx-indicator": ".htmx-loader,.loaded-content",
            })
        </div>
    </div>
}

templ DepartmentsJoin(depts []models.Department, user dto.UserAuth) {
    <div data-title="Departments" class="space-y-6">
        <div>
            <h2 class="text-3xl font-bold tracking-tight">Departments</h2>
            <p class="text-muted-foreground p-1">Browse departments and request to join</p>
        </div>
        <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
            if len(depts) == 0 {
                @components.NoData("No departments found", "No departments available yet", nil) {}
            }
            for _, dept := range depts {
                <div
                    hx-post={"/department?id="+dept.ID}
                    hx-target="#content"
                    hx-swap="innerHTML"
                    hx-push-url="true"
                    hx-indicator=".htmx-loader,.loaded-content"
                    class="rounded-lg border border-border bg-card text-card-foreground shadow-sm p-4 transition-all duration-300 hover:shadow-md hover:-translate-y-1 cursor-pointer"
                >
                    <div class="flex items-center justify-between space-y-0 pb-2">
                        <div class="flex gap-2">
                            <div class="p-1">
                                <div class={"w-7 h-7 p-2 rounded-md text-white flex items-center justify-center text-xs font-semibold " , dept.Color}>
                                    {strings.ToUpper(dept.Name[0:1])}
                                </div>
                            </div>
                            <div>
                                <h3 class="tracking-tight font-semibold">{dept.Name}</h3>
                                <div class="text-xs text-muted-foreground">{strconv.Itoa(len(dept.Members))} members</div>
                            </div>
                        </div>
                    </div>
                    <div class="min-h-[50px] p-1">
                        <p class="text-md">{dept.Description}</p>
                    </div>
                    <div class="pt-4 pb-4">
                        @components.DottedSeparator("", "#d4d4d8", "1px", "", "", "horizontal")
                    </div>
                    <div class="flex justify-end">
                        @ui.Button("join-dept-"+dept.ID, "outline", "sm", "user-plus", "Join", "", templ.Attributes{
                            "type": "button",
                            "hx-post": "/join-department?id="+dept.ID,
                            "hx-target": "#toaster",
                            "hx-swap": "innerHtml",
                            "hx-indicator": ".htmx-loader,.loaded-content",
                        })
                    </div>
                </div>
            }
        </div>
    </div>
}

templ InviteDepartment(deptID string, deptName string, deptColor string, class string, attrs templ.Attributes) {
    @components.ResponsiveModal("invite-department-modal", "Invite Members", class) {
        <div id="invite-department-form" 
            x-init={fmt.Sprintf("dept_id='%s'", deptID)}
            x-data="{
                        dept_id:'',
                        init() {
                            document.body.addEventListener('modal:opened', (evt) => {
                                if (evt.detail.id === 'invite-department-modal') {
                                    htmx.ajax('GET', '/invite-department-form?dept_id='+this.dept_id, {target: '#invite-department-form', swap: 'innerHtml'})
                                }
                            });
                            document.body.addEventListener('modal:closed', (evt) => {
                                if (evt.detail.id === 'invite-department-modal') {
                                    document.getElementById('invite-department-form').innerHTML = '';
                                }
                            });
                        }
                    }"
        >
        </div>
    }
}

templ InviteDepartmentForm(deptID string, deptName string, deptColor string, users []models.UserRole) {
    <div
        x-data="{
                    dept_id: '',
                    init() {
                        document.body.addEventListener('htmx:afterRequest', (evt) => {
                            if (evt.detail.successful && evt.detail.elt.id === 'invite-department-form') {
                                $store.modal.close('invite-department-modal');
                            }
                        });
                    }
                }"
        x-init={fmt.Sprintf("dept_id='%s'", deptID)}
    >
        <div class="flex items-center justify-start space-y-0">
            <div class="p-1 mr-2">
                <div class={"w-6 h-6 p-2 rounded-md text-white flex items-center justify-center text-sm font-semibold " , deptColor}>
                    {strings.ToUpper(deptName[0:1])}
                </div>
            </div>
            <h2 class="text-lg font-semibold tracking-tight">{deptName}</h2>
        </div>
        @ui.Form("/invite-department", "post", "", templ.Attributes{
                "id":"invite-department-form",
                "hx-target": "#toaster",
                "hx-swap": "innerHtml",
                "x-ref": "form",
        }) {
            <input id="dept_id" type="hidden" name="dept_id" x-model="dept_id" />
            @ui.FormItem("", nil) {
                @ui.FormLabel("invite_members", "Invite Members", "", nil)
                @components.MemberInput("invite_members",
                    "invite_members",
                    "Type a name...",
                    []models.UserRole{},  
                    users,
                    "",
                    nil,
                )
                @ui.FormMessage("", "", templ.Attributes{})
            }
            @components.DottedSeparator("", "#d4d4d8", "2px", "", "", "horizontal")
            <div class="flex justify-end items-end">
                @ui.Button("invite-button", "", "", "", "Invite", "", templ.Attributes{"type": "submit"}) 
            </div>
        }
    </div>
}