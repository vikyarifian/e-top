.env
.env.local
node_modules
tmp

bin
*.db
tailwindcss
*.exe

# artefak lokal, jangan dipublikasikan
*.dump
*.exe~

# Bahan tugas akhir: memuat nama karyawan, isi tiket perusahaan, dan
# dokumen yang bukan bagian dari aplikasi.
skripsi/

# Penyemai data penilaian: memuat nama karyawan beserta kategori
# kinerjanya. Tetap dapat dijalankan secara lokal.
cmd/seedeval/

# Berkas migrasi skema basis data, disimpan di luar repo atas permintaan
# pemilik proyek. Jalankan cmd/migrate dengan salinan lokalnya.
db/migrations/

# Pembangun basis data simulasi: memuat pemetaan data iTop beserta alamat
# folder kerja lokal. Tetap dapat dijalankan secara lokal.
cmd/simdb/

# Luaran server saat dijalankan dari baris perintah.
*.log
